---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Project } from '@/data/projects';
import { withBase } from '@/lib/paths';
import '@/styles/project-showcase.css';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const projectsHref = withBase('/projects/');
const chalkboardTexture = withBase('/images/contact/chalkboard-photo.webp');
const projectLinks = project.links ?? [];
const resolveLink = (href: string) =>
  href.startsWith('/') ? withBase(href) : href;

/*
 * Detail-page copy intentionally lives here instead of in projects.ts.
 * projects.ts feeds the Projects index too; keeping this prose local means
 * this redesign cannot change the index or any other project presentation.
 */
const projectWriting: Record<Project['slug'], string> = {
  '3tap':
    '3tap is the habit tracker I wanted to use myself: one row per habit, one column per day, and three simple states instead of streak pressure or a dashboard full of charts. A board works without a traditional account, and recovery plus device-transfer tools keep the data portable. I also added quick thoughts alongside the habit grid. Most of the engineering is hidden on purpose—keeping taps immediate while entries, habit order, archived items, recovery data, and cross-device state stay consistent through SvelteKit, Supabase, and Cloudflare.',
  neutra:
    'Neutra started as a Discord statistics bot and gradually turned into a much larger moderation and community-management system. It tracked server, user, message, emoji, and activity data in PostgreSQL; handled moderation, logging, roles, permissions, and configuration; and included a full music player with queues, playlists, and FFmpeg effects. With hundreds of commands spread across 25 categories and a large user base, it became my first long-lived software project—the place where I learned about migrations, permissions, reliability, documentation, and maintaining behavior as a codebase keeps growing.',
  sunset:
    'Sunset exists because UCLA court reservations are a timing problem more than a scheduling problem: tennis and pickleball slots open 72 hours ahead and good times can disappear almost immediately. I traced the authenticated reservation flow, then built a multi-user Playwright scheduler that keeps sessions alive, waits for the release window, retries quickly, logs what happened, and recovers automatically if the browser or service dies. It runs on a small Vultr server under systemd, so the repetitive part of getting a court happens without someone sitting on the booking page at exactly the right second.',
  keycad:
    'The current KeyCAD prototype is about the computer-vision-to-CAD pipeline itself. A user uploads an image, OpenCV isolates the strongest foreground contour, the API converts that result into normalized geometry, and a separate CAD service generates an intentionally non-lock-compatible OpenSCAD demonstration token. The web app draws the analysis back over the source image and shows a lightweight Three.js preview. I kept the Next.js frontend, FastAPI analysis service, and OpenSCAD adapter deliberately separate so the vision, geometry schema, and renderer can each be tested or replaced without rewriting the rest of the project.',
  portfolio:
    'Hecate946.com is my attempt to make a portfolio feel like one place instead of a stack of unrelated pages. The brick room, floor, navigation, parchment resumes, contact layout, and project pages share the same visual system, while the home transition opens into a Three.js/WebGL hallway with interactive paintings. Astro handles the mostly static structure and Svelte handles the stateful pieces such as theme, audio, room interactions, and WebGL controls. I keep rebuilding parts of it as I learn more about responsive layout, accessibility, rendering performance, and how far an interface can have a personality before it gets in the user’s way.',
  sketyl:
    'Sketyl was a Spotify statistics site I built to explore listening data whenever I wanted instead of waiting for an annual recap. After Spotify OAuth, the Quart app could load top tracks and artists across Spotify’s time ranges, recent and liked tracks, genres, decades, profiles, and the currently playing song. The backend is asynchronous—Quart, aiohttp, and asyncpg—and it preloads heavier Spotify requests in background tasks so the main views stay responsive. It was one of my first projects built around a third-party API, authentication, persistent user data, and information that changes every time someone listens to music.',
  webserver:
    'I wrote this C web server for an earlier version of my personal site because I wanted to understand what happens underneath a web framework. It opens a listening socket, reads simple GET requests, maps request paths to files, chooses a MIME type, and writes HTTP/1.1 responses with the correct content length; binary files are copied by length rather than treated as strings. A small in-memory cache stores up to 30 requested files to avoid reading the same assets from disk repeatedly. The server is intentionally synchronous and the frontend in the same repository is plain HTML, CSS, and JavaScript.',
};

const writing = projectWriting[project.slug];

const projectUrl = new URL(`/projects/${project.slug}/`, Astro.site).href;
const projectsUrl = new URL('/projects/', Astro.site).href;
const siteUrl = new URL('/', Astro.site).href;
const projectSocialImages: Record<Project['slug'], string> = {
  '3tap': '/images/social/projects.jpg',
  neutra: '/images/social/projects/neutra.jpg',
  sunset: '/images/social/projects/sunset.jpg',
  keycad: '/images/social/projects/keycad.jpg',
  portfolio: '/images/social/projects/portfolio.jpg',
  sketyl: '/images/social/projects.jpg',
  webserver: '/images/social/projects.jpg',
};
const projectSocialImagePath = projectSocialImages[project.slug];
const projectSocialImageUrl = new URL(projectSocialImagePath, Astro.site).href;
const sourceLink = projectLinks.find((link) => /source/i.test(link.label));
const projectStructuredData = [
  {
    '@type': 'SoftwareSourceCode',
    '@id': `${projectUrl}#project`,
    name: project.title,
    description: project.description,
    abstract: writing,
    url: projectUrl,
    image: projectSocialImageUrl,
    creator: { '@id': `${siteUrl}#person` },
    programmingLanguage: [...project.technologies],
    keywords: [...project.technologies, project.category].join(', '),
    genre: project.category,
    temporalCoverage: project.period,
    isAccessibleForFree: true,
    ...(sourceLink ? { codeRepository: sourceLink.href } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${projectUrl}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Projects',
        item: projectsUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: project.title,
        item: projectUrl,
      },
    ],
  },
];
---

<BaseLayout
  title={`${project.title} — Project`}
  description={project.description}
  socialTitle={project.title}
  socialDescription={project.tagline}
  socialImage={projectSocialImagePath}
  socialImageAlt={`${project.title} project preview`}
  socialImageWidth={400}
  socialImageHeight={400}
  mainEntityId={`${projectUrl}#project`}
  breadcrumbId={`${projectUrl}#breadcrumb`}
  structuredData={projectStructuredData}
  mainClass="project-detail-main"
  bodyClass={`project-detail-page project-detail-page--${project.slug}`}
>
  <article class="project-page" aria-labelledby="project-title">
    <div class="project-board-stage">
      <div class="project-chalkboard-wrap">
        <div class="project-chalkboard__recess">
          <div class="project-chalkboard__glass">
            <section
              class="project-chalkboard"
              aria-label={`${project.title} project chalkboard`}
            >
              <img
                class="project-chalkboard__texture"
                src={chalkboardTexture}
                alt=""
                width="1600"
                height="1000"
                draggable="false"
                decoding="async"
              />

              <div class="project-chalkboard__copy">
                <p class="project-timeline">{project.period}</p>
                <h1 id="project-title">{project.title}</h1>

                <p class="project-writing">{writing}</p>

                <div class="project-page__links">
                  <a class="project-back-link" href={projectsHref}>
                    <svg
                      class="project-link-arrow"
                      viewBox="0 0 16 16"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path d="M6.5 3.75 2.25 8l4.25 4.25M2.75 8h11"></path>
                    </svg>
                    <span>Projects</span>
                  </a>

                  {
                    projectLinks.length > 0 && (
                      <nav aria-label={`${project.title} links`}>
                        <ul class="project-links">
                          {projectLinks.map((link) => (
                            <li>
                              <a
                                href={resolveLink(link.href)}
                                target={
                                  link.href.startsWith('http')
                                    ? '_blank'
                                    : undefined
                                }
                                rel={
                                  link.href.startsWith('http')
                                    ? 'noopener noreferrer'
                                    : undefined
                                }
                              >
                                {link.label}
                                <svg
                                  class="project-link-arrow"
                                  viewBox="0 0 16 16"
                                  aria-hidden="true"
                                  focusable="false"
                                >
                                  <path d="M4 12 12 4M6.25 4H12v5.75" />
                                </svg>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </nav>
                    )
                  }
                </div>
              </div>
            </section>
          </div>
        </div>

        <div class="project-chalkboard__sill" aria-hidden="true"></div>
      </div>
    </div>
  </article>

  <script>
    let projectFitFrame = 0;

    type ProjectShowcaseWindow = Window & {
      __hecateProjectShowcaseHandlersInstalled?: boolean;
      __hecateProjectShowcaseResizeObserver?: ResizeObserver;
    };
    const projectShowcaseWindow = window as ProjectShowcaseWindow;

    const fitProjectChalkboard = () => {
      const stage = document.querySelector<HTMLElement>('.project-board-stage');
      const board = document.querySelector<HTMLElement>(
        '.project-chalkboard-wrap',
      );
      const copy = document.querySelector<HTMLElement>(
        '.project-chalkboard__copy',
      );
      if (!stage || !board || !copy) return;

      /*
       * The board now follows the copy's natural height, so short content stays
       * compact. Only when that natural board would exceed the actual room do
       * we reduce the copy's real font-size. Because this changes layout rather
       * than applying transform: scale(), the paragraph and footer can never
       * visually occupy the same space.
       */
      copy.style.removeProperty('font-size');

      const baseFontSize =
        Number.parseFloat(getComputedStyle(copy).fontSize) || 16;
      const availableHeight = Math.max(1, stage.clientHeight - 8);
      const fits = () =>
        board.getBoundingClientRect().height <= availableHeight + 0.5;

      if (fits()) return;

      const setScale = (scale: number) => {
        copy.style.fontSize = `${baseFontSize * scale}px`;
        return fits();
      };

      let low = 0.56;
      let high = 1;

      // Very short landscape windows may need a smaller emergency floor.
      if (!setScale(low)) {
        low = 0.46;
        if (!setScale(low)) {
          setScale(0.4);
          return;
        }
      }

      for (let index = 0; index < 14; index += 1) {
        const candidate = (low + high) / 2;
        if (setScale(candidate)) low = candidate;
        else high = candidate;
      }

      setScale(Math.max(0.4, low - 0.004));
    };

    const scheduleProjectFit = () => {
      window.cancelAnimationFrame(projectFitFrame);
      projectFitFrame = window.requestAnimationFrame(fitProjectChalkboard);
    };

    const observeCurrentProjectBoard = () => {
      projectShowcaseWindow.__hecateProjectShowcaseResizeObserver?.disconnect();

      if ('ResizeObserver' in window) {
        const observer = new ResizeObserver(scheduleProjectFit);
        const stage = document.querySelector<HTMLElement>(
          '.project-board-stage',
        );
        if (stage) observer.observe(stage);
        projectShowcaseWindow.__hecateProjectShowcaseResizeObserver = observer;
      }
    };

    const resetProjectPage = () => {
      const copy = document.querySelector<HTMLElement>(
        '.project-chalkboard__copy',
      );
      copy?.style.removeProperty('font-size');
      observeCurrentProjectBoard();
      scheduleProjectFit();
    };

    resetProjectPage();
    document.fonts?.ready.then(scheduleProjectFit);

    if (!projectShowcaseWindow.__hecateProjectShowcaseHandlersInstalled) {
      projectShowcaseWindow.__hecateProjectShowcaseHandlersInstalled = true;
      document.addEventListener('astro:after-swap', resetProjectPage);
      window.addEventListener('resize', scheduleProjectFit, { passive: true });
      window.addEventListener('orientationchange', scheduleProjectFit, {
        passive: true,
      });
      window.addEventListener('pageshow', (event) => {
        if (event.persisted) resetProjectPage();
        else scheduleProjectFit();
      });
    }
  </script>
</BaseLayout>
