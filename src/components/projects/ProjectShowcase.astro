---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Project } from '@/data/projects';
import { withBase } from '@/lib/paths';
import '@/styles/project-showcase.css';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const projectsHref = withBase('/projects/');
const chalkboardTexture = withBase('/images/contact/chalkboard-photo.webp');
const projectLinks = project.links ?? [];
const resolveLink = (href: string) => (href.startsWith('/') ? withBase(href) : href);

/*
 * Detail-page copy intentionally lives here instead of in projects.ts.
 * projects.ts feeds the Projects index too; keeping this prose local means
 * this redesign cannot change the index or any other project presentation.
 */
const projectWriting: Record<Project['slug'], string> = {
  neutra:
    'Neutra was one of the first projects where software stopped feeling like a small program and started feeling like a system I had to operate. I built it as one Discord platform for moderation, analytics, security, and music rather than a collection of disconnected bots. Over time it grew to 320 commands and was used by 500,000 people, which forced me to think seriously about data modeling, reliability, and what it means to maintain software at scale. Looking back, it is the project that taught me how much I enjoy building tools that become infrastructure for other people.',
  sunset:
    'I built Sunset because reserving UCLA tennis and pickleball courts had become a strangely competitive timing problem: inventory opened on a strict 72-hour schedule and disappeared almost immediately. I reverse engineered the authenticated booking flow and turned it into a multi-user scheduler that could preserve sessions, wait for the exact release window, retry quickly, and recover when a browser or process failed. It is a small project in scope, but I like it because it takes an annoying real-world ritual and makes the computer handle every fragile part of it.',
  keycad:
    'KeyCAD started with a question I found interesting: could a photograph contain enough information to recreate useful physical geometry? I built a library of 19 parameterized key blanks in OpenSCAD, then wrote an OpenCV pipeline that corrected scale, found measurement points in an image, and transferred those measurements onto the matching model to produce printable geometry. What I like most about the project is the bridge between two very different kinds of computation—interpreting pixels on one side and generating a precise physical object on the other.',
  portfolio:
    'I built Hecate946.com because I wanted a personal website to feel less like a document and more like a place. The site is statically generated with Astro, with Svelte and WebGL used only where interaction earns the extra complexity, and I keep rebuilding parts of it whenever I find a visual idea worth exploring. It has become an ongoing experiment in animation, interface design, accessibility, performance, and how much personality a website can have without becoming difficult to use. More than a portfolio, it is the project where I let myself treat the browser as a creative medium.',
};

const writing = projectWriting[project.slug];

const projectUrl = new URL(`/projects/${project.slug}/`, Astro.site).href;
const projectsUrl = new URL('/projects/', Astro.site).href;
const siteUrl = new URL('/', Astro.site).href;
const projectImageUrl = new URL(project.image, Astro.site).href;
const sourceLink = projectLinks.find((link) => /source/i.test(link.label));
const projectStructuredData = [
  {
    '@type': 'SoftwareSourceCode',
    '@id': `${projectUrl}#project`,
    name: project.title,
    description: project.description,
    abstract: writing,
    url: projectUrl,
    image: projectImageUrl,
    creator: { '@id': `${siteUrl}#person` },
    programmingLanguage: [...project.technologies],
    keywords: [...project.technologies, project.category].join(', '),
    genre: project.category,
    temporalCoverage: project.period,
    isAccessibleForFree: true,
    ...(sourceLink ? { codeRepository: sourceLink.href } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${projectUrl}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Projects',
        item: projectsUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: project.title,
        item: projectUrl,
      },
    ],
  },
];
---

<BaseLayout
  title={`${project.title} — Project`}
  description={project.description}
  socialTitle={project.title}
  socialDescription={project.tagline}
  socialImage={`/images/social/projects/${project.slug}.jpg`}
  socialImageAlt={`${project.title} project preview`}
  socialImageWidth={400}
  socialImageHeight={400}
  socialImageType="image/jpeg"
  structuredData={projectStructuredData}
  mainClass="project-detail-main"
  bodyClass={`project-detail-page project-detail-page--${project.slug}`}
>
  <article class="project-page" aria-labelledby="project-title">
    <div class="project-board-stage">
      <div class="project-chalkboard-wrap">
        <div class="project-chalkboard__recess">
          <div class="project-chalkboard__glass">
            <section class="project-chalkboard" aria-label={`${project.title} project chalkboard`}>
              <img
                class="project-chalkboard__texture"
                src={chalkboardTexture}
                alt=""
                width="1600"
                height="1000"
                draggable="false"
                decoding="async"
              />

              <div class="project-chalkboard__copy">
                <p class="project-timeline">{project.period}</p>
                <h1 id="project-title">{project.title}</h1>

                <p class="project-writing">{writing}</p>

                <div class="project-page__links">
                  <a class="project-back-link" href={projectsHref}>
                    <svg class="project-link-arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <path d="M6.5 3.75 2.25 8l4.25 4.25M2.75 8h11" />
                    </svg>
                    <span>Projects</span>
                  </a>

                  {
                    projectLinks.length > 0 && (
                      <nav aria-label={`${project.title} links`}>
                        <ul class="project-links">
                          {projectLinks.map((link) => (
                            <li>
                              <a
                                href={resolveLink(link.href)}
                                target={link.href.startsWith('http') ? '_blank' : undefined}
                                rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                              >
                                {link.label}<svg class="project-link-arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 12 12 4M6.25 4H12v5.75" /></svg>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </nav>
                    )
                  }
                </div>
              </div>
            </section>
          </div>
        </div>

        <div class="project-chalkboard__sill" aria-hidden="true"></div>
      </div>
    </div>
  </article>

  <script>
    let projectFitFrame = 0;

    type ProjectShowcaseWindow = Window & {
      __hecateProjectShowcaseHandlersInstalled?: boolean;
      __hecateProjectShowcaseResizeObserver?: ResizeObserver;
    };
    const projectShowcaseWindow = window as ProjectShowcaseWindow;

    const fitProjectChalkboard = () => {
      const stage = document.querySelector<HTMLElement>('.project-board-stage');
      const board = document.querySelector<HTMLElement>('.project-chalkboard-wrap');
      const copy = document.querySelector<HTMLElement>('.project-chalkboard__copy');
      if (!stage || !board || !copy) return;

      /*
       * The board now follows the copy's natural height, so short content stays
       * compact. Only when that natural board would exceed the actual room do
       * we reduce the copy's real font-size. Because this changes layout rather
       * than applying transform: scale(), the paragraph and footer can never
       * visually occupy the same space.
       */
      copy.style.removeProperty('font-size');

      const baseFontSize = Number.parseFloat(getComputedStyle(copy).fontSize) || 16;
      const availableHeight = Math.max(1, stage.clientHeight - 8);
      const fits = () => board.getBoundingClientRect().height <= availableHeight + 0.5;

      if (fits()) return;

      const setScale = (scale: number) => {
        copy.style.fontSize = `${baseFontSize * scale}px`;
        return fits();
      };

      let low = 0.56;
      let high = 1;

      // Very short landscape windows may need a smaller emergency floor.
      if (!setScale(low)) {
        low = 0.46;
        if (!setScale(low)) {
          setScale(0.4);
          return;
        }
      }

      for (let index = 0; index < 14; index += 1) {
        const candidate = (low + high) / 2;
        if (setScale(candidate)) low = candidate;
        else high = candidate;
      }

      setScale(Math.max(0.4, low - 0.004));
    };

    const scheduleProjectFit = () => {
      window.cancelAnimationFrame(projectFitFrame);
      projectFitFrame = window.requestAnimationFrame(fitProjectChalkboard);
    };

    const observeCurrentProjectBoard = () => {
      projectShowcaseWindow.__hecateProjectShowcaseResizeObserver?.disconnect();

      if ('ResizeObserver' in window) {
        const observer = new ResizeObserver(scheduleProjectFit);
        const stage = document.querySelector<HTMLElement>('.project-board-stage');
        if (stage) observer.observe(stage);
        projectShowcaseWindow.__hecateProjectShowcaseResizeObserver = observer;
      }
    };

    const resetProjectPage = () => {
      const copy = document.querySelector<HTMLElement>('.project-chalkboard__copy');
      copy?.style.removeProperty('font-size');
      observeCurrentProjectBoard();
      scheduleProjectFit();
    };

    resetProjectPage();
    document.fonts?.ready.then(scheduleProjectFit);

    if (!projectShowcaseWindow.__hecateProjectShowcaseHandlersInstalled) {
      projectShowcaseWindow.__hecateProjectShowcaseHandlersInstalled = true;
      document.addEventListener('astro:after-swap', resetProjectPage);
      window.addEventListener('resize', scheduleProjectFit, { passive: true });
      window.addEventListener('orientationchange', scheduleProjectFit, { passive: true });
      window.addEventListener('pageshow', (event) => {
        if (event.persisted) resetProjectPage();
        else scheduleProjectFit();
      });
    }
  </script>
</BaseLayout>
