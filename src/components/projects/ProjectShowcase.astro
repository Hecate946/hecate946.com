---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Project } from '@/data/projects';
import { withBase } from '@/lib/paths';
import '@/styles/project-showcase.css';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const image = withBase(project.image);
const projectsHref = withBase('/projects/');
const projectLinks = project.links ?? [];
const resolveLink = (href: string) => href.startsWith('/') ? withBase(href) : href;
---

<BaseLayout
  title={project.title}
  description={project.description}
  image={project.image}
>
  <article class="project-showcase interior-page interior-page--six">
    <header class="project-header interior-page-column">
      <a class="project-back-link" href={projectsHref}>
        <span aria-hidden="true">←</span> Projects
      </a>

      <p class="project-kicker">{project.category} · {project.period}</p>
      <h1>{project.title}</h1>
      <p class="project-tagline">{project.tagline}</p>

      {
        projectLinks.length > 0 && (
          <nav aria-label={`${project.title} links`}>
            <ul class="project-links">
              {projectLinks.map((link) => (
                <li>
                  <a
                    href={resolveLink(link.href)}
                    target={link.href.startsWith('http') ? '_blank' : undefined}
                    rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    {link.label} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </header>

    <figure class="project-image interior-page-column">
      <img
        src={image}
        alt={project.imageAlt}
        width="1600"
        height="1000"
        decoding="async"
        fetchpriority="high"
      />
    </figure>

    <div class="project-content interior-page-column">
      <section class="project-overview" aria-labelledby="overview-heading">
        <h2 id="overview-heading">Overview</h2>
        <p>{project.description}</p>

        <dl class="project-meta">
          <div>
            <dt>Role</dt>
            <dd>{project.role}</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>{project.status}</dd>
          </div>
          <div>
            <dt>Built with</dt>
            <dd>{project.technologies.join(', ')}</dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="challenge-heading">
        <h2 id="challenge-heading">Challenge</h2>
        <p>{project.challenge}</p>
      </section>

      <section aria-labelledby="approach-heading">
        <h2 id="approach-heading">Approach</h2>
        <p>{project.approach}</p>
      </section>

      <section aria-labelledby="result-heading">
        <h2 id="result-heading">Result</h2>
        <p>{project.result}</p>
      </section>

      <section aria-labelledby="highlights-heading">
        <h2 id="highlights-heading">Highlights</h2>
        <ul>
          {project.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
      </section>

      <footer class="project-footer-nav">
        <a href={projectsHref}><span aria-hidden="true">←</span> All projects</a>
      </footer>
    </div>
  </article>
</BaseLayout>
