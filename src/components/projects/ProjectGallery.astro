---
import { indexProjects } from '@/data/projects';
import { withBase } from '@/lib/paths';

const resolveHref = (href: string) =>
  href.startsWith('/') ? withBase(href) : href;
---

<section
  class="page-scroll-installation project-index"
  aria-labelledby="project-index-title"
>
  <div class="page-scroll-hanging">
    <article class="page-scroll-paper">
      <div
        class="page-scroll-paper__roll page-scroll-paper__roll--top"
        aria-hidden="true"
      >
      </div>

      <div class="page-scroll-paper__sheet">
        <div
          class="page-scroll-paper__viewport project-scroll-viewport"
          aria-label="Projects content"
        >
          <header class="page-scroll-header">
            <h1 id="project-index-title">Projects</h1>
            <div class="page-scroll-header__rule" aria-hidden="true"></div>
          </header>

          <div class="project-sheet-scroll" aria-label="Projects table">
            <div class="project-sheet">
              <table>
                <colgroup>
                  <col class="project-sheet__name-column" />
                  <col class="project-sheet__description-column" />
                </colgroup>
                <thead>
                  <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    indexProjects.map((project) => (
                      <tr
                        data-project-row
                        data-project-href={resolveHref(project.primaryHref)}
                      >
                        <th scope="row">
                          <a
                            class="project-sheet__name"
                            href={resolveHref(project.primaryHref)}
                            data-astro-prefetch
                          >
                            <span class="project-sheet__name-title">
                              {project.title}
                            </span>
                          </a>
                        </th>
                        <td class="project-sheet__description">
                          <span>{project.description}</span>
                        </td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <div
        class="page-scroll-paper__roll page-scroll-paper__roll--bottom"
        aria-hidden="true"
      >
      </div>
    </article>
  </div>
</section>

<script>
  const installProjectRowLinks = () => {
    document
      .querySelectorAll<HTMLTableRowElement>('[data-project-row]')
      .forEach((row) => {
        if (row.dataset.projectRowReady === 'true') return;
        row.dataset.projectRowReady = 'true';

        row.addEventListener('click', (event) => {
          const target = event.target;
          if (target instanceof Element && target.closest('a')) return;

          const href = row.dataset.projectHref;
          if (href) window.location.assign(href);
        });
      });
  };

  installProjectRowLinks();
  document.addEventListener('astro:after-swap', installProjectRowLinks);
</script>
