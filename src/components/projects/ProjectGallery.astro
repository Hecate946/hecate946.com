---
import { indexProjects } from '@/data/projects';
import { withBase } from '@/lib/paths';

const resolveHref = (href: string) =>
  href.startsWith('/') ? withBase(href) : href;
const isExternal = (href: string) => href.startsWith('http');
---

<section class="project-index" aria-labelledby="project-index-title">
  <h1 class="project-index__sr-title" id="project-index-title">Projects</h1>

  <ol class="project-grid">
    {
      indexProjects.map((project) => (
        <li class="project-grid__item">
          <a
            class="project-entry"
            href={resolveHref(project.primaryHref)}
            target={isExternal(project.primaryHref) ? '_blank' : undefined}
            rel={
              isExternal(project.primaryHref)
                ? 'noopener noreferrer'
                : undefined
            }
            data-astro-prefetch={!isExternal(project.primaryHref)}
            aria-label={`Open ${project.title}`}
          >
            <h2>{project.title}</h2>
            <svg
              class="project-entry__arrow"
              viewBox="0 0 16 16"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M4 12 12 4M6.25 4H12v5.75" />
            </svg>
          </a>
        </li>
      ))
    }
  </ol>
</section>
