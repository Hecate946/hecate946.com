---
import type { Project } from '@/data/projects';
import { withBase } from '@/lib/paths';

interface Props {
  project: Project;
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
const href = withBase(`/projects/${project.slug}/`);
const image = withBase(project.image);
const displayUrl = `hecate946.com/projects/${project.slug}`;
---

<a class="project-window" href={href} aria-label={`View the ${project.title} case study`}>
  <span class="project-window__image">
    <img
      src={image}
      alt=""
      width="1600"
      height="1000"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
    <strong class="project-window__title" aria-hidden="true">{project.title}</strong>
    <span class="project-window__open" aria-hidden="true">
      View project <span>↗</span>
    </span>
  </span>

  <span class="project-window__caption">
    <small>{project.category} · {project.period}</small>
    <span class="project-window__url">{displayUrl}</span>
  </span>
</a>
