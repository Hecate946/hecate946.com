---
import type { Project } from '@/data/projects';
import { withBase } from '@/lib/paths';

interface Props {
  project: Project;
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
const href = withBase(`/projects/${project.slug}/`);
const image = withBase(project.image);
const imageStem = project.image.replace(/\.webp$/i, '');
const imageSrcset = [640, 960, 1200]
  .map((width) => `${withBase(`${imageStem}-${width}.webp`)} ${width}w`)
  .concat(`${image} 1600w`)
  .join(', ');
const imageSizes = '(max-width: 39.999rem) calc(100vw - 2rem), 50vw';
---

<li class="project-window-item">
  <article class="project-window">
    <div class="project-window__image">
      <img
        src={image}
        srcset={imageSrcset}
        sizes={imageSizes}
        alt=""
        width="1600"
        height="1000"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'low'}
        decoding="async"
      />
      <a class="project-window__link" href={href} aria-label={`View the ${project.title} case study`}>
        <h2 class="project-window__title">{project.title}</h2>
      </a>
      <span class="project-window__open" aria-hidden="true">
        <span class="ui-text">View project</span><span class="ui-text">↗</span>
      </span>
    </div>

    <footer class="project-window__caption">
      <p><small>{project.category} · {project.period}</small></p>
    </footer>
  </article>
</li>
