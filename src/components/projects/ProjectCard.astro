---
import type { Project } from '@/data/projects';
import { withBase } from '@/lib/paths';

interface Props {
  project: Project;
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
const href = withBase(`/projects/${project.slug}/`);
const image = withBase(project.image);
---

<li class="project-window-item">
  <article class="project-window">
    <div class="project-window__image">
      <img
        src={image}
        alt=""
        width="1600"
        height="1000"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
      <a class="project-window__link" href={href} aria-label={`View the ${project.title} case study`}>
        <h2 class="project-window__title">{project.title}</h2>
      </a>
      <span class="project-window__open" aria-hidden="true">
        View project <span>↗</span>
      </span>
    </div>

    <footer class="project-window__caption">
      <p><small>{project.category} · {project.period}</small></p>
    </footer>
  </article>
</li>
