---
import { siteConfig } from '@/config/site';
import { withBase } from '@/lib/paths';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: string | undefined;
  imageAlt?: string | undefined;
  imageWidth?: number | undefined;
  imageHeight?: number | undefined;
  imageType?: string | undefined;
  canonicalURL?: URL | undefined;
  noindex?: boolean | undefined;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  imageType,
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  noindex = false,
} = Astro.props;

const escapeRegExp = (value: string) =>
  value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const siteNamePattern = escapeRegExp(siteConfig.name);
const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHomePage = normalizedPath === '/';
const isAboutPage = normalizedPath === '/about';

function getPageName(input: string) {
  const cleanTitle = input.trim();

  if (!cleanTitle || cleanTitle === siteConfig.name || cleanTitle === siteConfig.title) {
    return siteConfig.name;
  }

  return (
    cleanTitle
      .replace(
        new RegExp(`\\s*(?:\\||—|–|-)\\s*${siteNamePattern}\\s*$`, 'i'),
        '',
      )
      .trim() || siteConfig.name
  );
}

function inferImageType(path: string) {
  const cleanPath = path.split(/[?#]/, 1)[0]?.toLowerCase() ?? '';
  if (cleanPath.endsWith('.webp')) return 'image/webp';
  if (cleanPath.endsWith('.png')) return 'image/png';
  if (cleanPath.endsWith('.jpg') || cleanPath.endsWith('.jpeg')) return 'image/jpeg';
  if (cleanPath.endsWith('.gif')) return 'image/gif';
  return undefined;
}

const pageName = getPageName(title);
const resolvedTitle = isHomePage ? siteConfig.title : `${pageName} | ${siteConfig.name}`;
const canonicalHref = canonicalURL.toString();
const siteUrl = new URL('/', Astro.site).toString();
const defaultSocialImagePath = withBase('/images/social/cyrus-asasi-og.jpg');
const resolvedImagePath = image ?? defaultSocialImagePath;
const socialImage = new URL(resolvedImagePath, Astro.site).toString();
const socialImageAlt = imageAlt ?? (
  image
    ? `${pageName} — project preview by ${siteConfig.name}`
    : `${siteConfig.name}, software engineer and classical musician`
);
const socialImageWidth = imageWidth ?? (image ? undefined : 1200);
const socialImageHeight = imageHeight ?? (image ? undefined : 630);
const socialImageType = imageType ?? inferImageType(resolvedImagePath);
const personId = `${siteUrl}#person`;
const websiteId = `${siteUrl}#website`;
const webPageId = `${canonicalHref}#webpage`;
const portraitUrl = new URL(withBase('/images/about/cyrus-portrait.webp'), Astro.site).toString();

const structuredImage = (image || isAboutPage)
  ? {
      '@type': 'ImageObject',
      url: isAboutPage ? portraitUrl : socialImage,
      contentUrl: isAboutPage ? portraitUrl : socialImage,
      caption: isAboutPage ? `Portrait of ${siteConfig.name}` : socialImageAlt,
      ...(isAboutPage
        ? { width: 400, height: 400 }
        : {
            ...(socialImageWidth ? { width: socialImageWidth } : {}),
            ...(socialImageHeight ? { height: socialImageHeight } : {}),
          }),
    }
  : undefined;

const personStructuredData = {
  '@type': 'Person',
  '@id': personId,
  name: siteConfig.name,
  url: siteUrl,
  sameAs: [siteConfig.social.github, siteConfig.social.linkedin],
  ...(isAboutPage
    ? {
        image: portraitUrl,
        jobTitle: 'Software Engineer and Classical Musician',
      }
    : {}),
};

const pageStructuredData = {
  '@type': isAboutPage ? 'ProfilePage' : 'WebPage',
  '@id': webPageId,
  url: canonicalHref,
  name: resolvedTitle,
  description,
  inLanguage: siteConfig.locale,
  isPartOf: { '@id': websiteId },
  author: { '@id': personId },
  ...(isAboutPage ? { mainEntity: { '@id': personId } } : {}),
  ...(structuredImage ? { primaryImageOfPage: structuredImage } : {}),
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    personStructuredData,
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteUrl,
      name: siteConfig.name,
      alternateName: 'hecate946.com',
      description: siteConfig.description,
      inLanguage: siteConfig.locale,
      creator: { '@id': personId },
    },
    pageStructuredData,
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- Canonicalize the public site as early as possible. GitHub Pages normally
     performs the HTTP -> HTTPS redirect before this document is served, but
     this is a defensive fallback for caches/proxies and also collapses the
     www host onto the canonical apex origin. Path, query, and hash survive. -->
<script is:inline>
  (() => {
    const url = new URL(window.location.href);
    const isPublicHost = url.hostname === 'hecate946.com' || url.hostname === 'www.hecate946.com';
    if (!isPublicHost) return;

    const needsHttps = url.protocol === 'http:';
    const needsCanonicalHost = url.hostname === 'www.hecate946.com';
    if (!needsHttps && !needsCanonicalHost) return;

    url.protocol = 'https:';
    url.hostname = 'hecate946.com';
    url.port = '';
    window.location.replace(url.toString());
  })();
</script>
<meta name="description" content={description} />
<meta name="author" content={siteConfig.name} />
<meta name="application-name" content={siteConfig.name} />
<meta name="apple-mobile-web-app-title" content={siteConfig.shortName} />
<meta name="color-scheme" content="light dark" />
<meta name="referrer" content="same-origin" />
<meta
  name="robots"
  content={noindex
    ? 'noindex'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>
<meta
  name="theme-color"
  media="(prefers-color-scheme: light)"
  content="#0d6965"
/>
<meta
  name="theme-color"
  media="(prefers-color-scheme: dark)"
  content="#051417"
/>

<link rel="canonical" href={canonicalHref} />
<link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" sizes="any" />
<link rel="icon" href={withBase('/favicon-48.png')} type="image/png" sizes="48x48" />
<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} sizes="180x180" />
<link rel="me" href={siteConfig.social.github} />
<link rel="me" href={siteConfig.social.linkedin} />

<!-- The display font is render-critical on every page. Warm both Google font
     origins so the stylesheet and font file do not each pay a fresh DNS/TLS
     setup cost; the stylesheet itself still sends no referrer. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,300..500&display=swap"
  rel="stylesheet"
  referrerpolicy="no-referrer"
/>

<title>{resolvedTitle}</title>

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={siteConfig.locale.replace('-', '_')} />
<meta property="og:title" content={resolvedTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalHref} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:secure_url" content={socialImage} />
<meta property="og:image:alt" content={socialImageAlt} />
{socialImageType && <meta property="og:image:type" content={socialImageType} />}
{socialImageWidth && <meta property="og:image:width" content={String(socialImageWidth)} />}
{socialImageHeight && <meta property="og:image:height" content={String(socialImageHeight)} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={socialImageAlt} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
