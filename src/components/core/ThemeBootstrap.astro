<script is:inline>
  (() => {
    const seasonNames = ['spring', 'summer', 'autumn', 'winter'];
    const themeNames = ['light', 'dark'];
    const darkModeQuery = window.matchMedia('(prefers-color-scheme: dark)');

    /* HTML mode is intentionally literal: it disables author stylesheets and
       removes inline style attributes, but it never changes element visibility
       or substitutes alternate/hidden content. Native HTML attributes such as
       `hidden`, `open`, `alt`, `width`, and `height` keep their normal browser
       meaning. */
    const styleNodeState = new WeakMap();
    const inlineStyleState = new WeakMap();
    const inlineStyleElements = new Set();

    const isStyleNode = (node) =>
      node instanceof HTMLStyleElement ||
      (node instanceof HTMLLinkElement && node.relList.contains('stylesheet'));

    const setStyleNodeDisabled = (node, disabled) => {
      if (!isStyleNode(node)) return;
      if (!styleNodeState.has(node)) styleNodeState.set(node, Boolean(node.disabled));
      node.disabled = disabled ? true : styleNodeState.get(node);
    };

    const syncInlineStyle = (element, htmlMode) => {
      if (!(element instanceof Element)) return;

      if (htmlMode) {
        const currentStyle = element.getAttribute('style');
        if (currentStyle === null) return;

        // Components may keep updating transforms or dimensions while CSS is
        // disabled. Remember the newest authored value so returning to the
        // standard site resumes from the current state, not a stale snapshot.
        inlineStyleState.set(element, currentStyle);
        inlineStyleElements.add(element);
        element.removeAttribute('style');
        return;
      }

      if (!inlineStyleState.has(element)) return;
      const original = inlineStyleState.get(element);
      if (original === null) element.removeAttribute('style');
      else element.setAttribute('style', original);
      inlineStyleState.delete(element);
      inlineStyleElements.delete(element);
    };

    const restoreInlineStyles = (targetDocument) => {
      for (const element of Array.from(inlineStyleElements)) {
        if (element.ownerDocument !== targetDocument) continue;

        if (!targetDocument.documentElement.contains(element)) {
          inlineStyleState.delete(element);
          inlineStyleElements.delete(element);
          continue;
        }

        syncInlineStyle(element, false);
      }
    };

    const applyHtmlPresentation = (targetDocument, htmlMode) => {
      const root = targetDocument.documentElement;
      root.dataset.htmlMode = String(htmlMode);

      targetDocument
        .querySelectorAll('style, link[rel~="stylesheet"]')
        .forEach((node) => setStyleNodeDisabled(node, htmlMode));

      if (htmlMode) {
        targetDocument
          .querySelectorAll('[style]')
          .forEach((element) => syncInlineStyle(element, true));
        syncInlineStyle(root, true);
      } else {
        restoreInlineStyles(targetDocument);
      }
    };

    window.__hecateApplyHtmlPresentation = applyHtmlPresentation;

    const automaticSeason = () => {
      const month = new Date().getMonth();
      if (month >= 2 && month <= 4) return 'spring';
      if (month >= 5 && month <= 7) return 'summer';
      if (month >= 8 && month <= 10) return 'autumn';
      return 'winter';
    };

    const readPreference = (key) => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    };

    const readPercentPreference = (key) => {
      const raw = readPreference(key);
      if (raw === null) return 0;
      const value = Number(raw);
      if (!Number.isFinite(value)) return 0;
      return Math.min(100, Math.max(0, Math.round(value)));
    };

    const resolvePreferences = () => {
      const savedSeason = readPreference('season-preference');
      const seasonPreference = seasonNames.includes(savedSeason)
        ? savedSeason
        : 'auto';
      const season =
        seasonPreference === 'auto' ? automaticSeason() : seasonPreference;

      const savedTheme = readPreference('color-theme');
      const theme = themeNames.includes(savedTheme)
        ? savedTheme
        : darkModeQuery.matches
          ? 'dark'
          : 'light';

      return {
        seasonPreference,
        season,
        theme,
        musicVolume: readPercentPreference('site-audio:music-volume'),
        sfxVolume: readPercentPreference('site-audio:sfx-volume'),
        htmlMode: readPreference('html-mode') === 'html',
      };
    };

    const applyPreferences = (targetDocument = document) => {
      const { seasonPreference, season, theme, musicVolume, sfxVolume, htmlMode } =
        resolvePreferences();
      const root = targetDocument.documentElement;

      root.dataset.seasonPreference = seasonPreference;
      root.dataset.season = season;
      root.dataset.theme = theme;
      root.dataset.musicVolume = String(musicVolume);
      root.dataset.sfxVolume = String(sfxVolume);
      root.dataset.soundEnabled = String(sfxVolume > 0);
      root.dataset.audioActive = String(musicVolume > 0 || sfxVolume > 0);
      root.dataset.themeReady = 'true';

      applyHtmlPresentation(targetDocument, htmlMode);
      if (!htmlMode) root.style.colorScheme = theme;
    };

    const updateThemeColor = () => {
      if (document.documentElement.dataset.htmlMode === 'true') {
        document
          .querySelectorAll('meta[name="theme-color"]')
          .forEach((meta) => meta.setAttribute('content', '#ffffff'));
        return;
      }

      requestAnimationFrame(() => {
        const themeColor = getComputedStyle(document.documentElement)
          .getPropertyValue('--header-bg')
          .trim();

        if (themeColor) {
          document
            .querySelectorAll('meta[name="theme-color"]')
            .forEach((meta) => meta.setAttribute('content', themeColor));
        }
      });
    };

    /* Apply every stored visual and audio preference before first paint. */
    applyPreferences();

    if (!window.__cyrusThemeBootstrapInstalled) {
      window.__cyrusThemeBootstrapInstalled = true;

      const observer = new MutationObserver((mutations) => {
        const htmlMode = document.documentElement.dataset.htmlMode === 'true';
        if (!htmlMode) return;

        for (const mutation of mutations) {
          if (mutation.type === 'attributes') {
            const target = mutation.target;
            if (target instanceof Element && mutation.attributeName === 'style') {
              syncInlineStyle(target, true);
            }
            continue;
          }

          for (const node of mutation.addedNodes) {
            if (!(node instanceof Element)) continue;

            if (isStyleNode(node)) setStyleNodeDisabled(node, true);
            syncInlineStyle(node, true);

            node
              .querySelectorAll('style, link[rel~="stylesheet"]')
              .forEach((styleNode) => setStyleNodeDisabled(styleNode, true));
            node
              .querySelectorAll('[style]')
              .forEach((element) => syncInlineStyle(element, true));
          }
        }
      });

      observer.observe(document.documentElement, {
        subtree: true,
        childList: true,
        attributes: true,
        attributeFilter: ['style'],
      });

      document.addEventListener('astro:before-swap', (event) => {
        applyPreferences(event.newDocument);
      });

      document.addEventListener('astro:after-swap', () => {
        applyPreferences();
        updateThemeColor();
      });

      document.addEventListener('DOMContentLoaded', () => {
        applyPreferences();
        updateThemeColor();
      }, { once: true });

      darkModeQuery.addEventListener('change', () => {
        if (!readPreference('color-theme')) {
          applyPreferences();
          updateThemeColor();
        }
      });
    }
  })();
</script>
