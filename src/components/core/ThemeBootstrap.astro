<script is:inline>
  (() => {
    const THEME_STORAGE_KEY = 'color-theme';
    const themeNames = new Set(['light', 'dark']);
    const darkModeQuery = window.matchMedia('(prefers-color-scheme: dark)');

    const readPreference = () => {
      try {
        const saved = localStorage.getItem(THEME_STORAGE_KEY);
        return themeNames.has(saved) ? saved : null;
      } catch {
        return null;
      }
    };

    const resolveTheme = () => readPreference() ?? (darkModeQuery.matches ? 'dark' : 'light');

    const applyTheme = (targetDocument = document) => {
      const theme = resolveTheme();
      const root = targetDocument.documentElement;
      root.dataset.theme = theme;
      root.dataset.themeReady = 'true';
      root.style.colorScheme = theme;
    };

    const updateThemeColor = () => {
      requestAnimationFrame(() => {
        const themeColor = getComputedStyle(document.documentElement)
          .getPropertyValue('--bg')
          .trim();

        if (!themeColor) return;
        document
          .querySelectorAll('meta[name="theme-color"]')
          .forEach((meta) => meta.setAttribute('content', themeColor));
      });
    };

    // Retire preferences from removed UI systems without touching the one
    // remaining appearance preference.
    try {
      localStorage.removeItem('season-preference');
      localStorage.removeItem('html-mode');
      localStorage.removeItem('site-audio:music-volume');
      localStorage.removeItem('site-audio:sfx-volume');
      localStorage.removeItem('site-sound');
    } catch {
      // Storage may be unavailable; the visual theme still works normally.
    }

    applyTheme();

    if (!window.__cyrusThemeBootstrapInstalled) {
      window.__cyrusThemeBootstrapInstalled = true;

      document.addEventListener('astro:before-swap', (event) => {
        applyTheme(event.newDocument);
      });

      document.addEventListener('astro:after-swap', () => {
        applyTheme();
        updateThemeColor();
      });

      document.addEventListener(
        'DOMContentLoaded',
        () => {
          applyTheme();
          updateThemeColor();
        },
        { once: true },
      );

      darkModeQuery.addEventListener('change', () => {
        if (readPreference()) return;
        applyTheme();
        updateThemeColor();
      });
    }
  })();
</script>
