<script is:inline>
  (() => {
    const THEME_STORAGE_KEY = 'color-theme';
    const themeNames = new Set(['light', 'dark']);
    const darkModeQuery = window.matchMedia('(prefers-color-scheme: dark)');

    const readPreference = () => {
      try {
        const saved = localStorage.getItem(THEME_STORAGE_KEY);
        return themeNames.has(saved) ? saved : null;
      } catch {
        return null;
      }
    };

    const resolveTheme = () => readPreference() ?? (darkModeQuery.matches ? 'dark' : 'light');

    const applyTheme = (targetDocument = document) => {
      const theme = resolveTheme();
      const root = targetDocument.documentElement;
      root.dataset.theme = theme;
      root.dataset.themeReady = 'true';
      root.style.colorScheme = theme;
    };

    const resolveBrowserThemeColor = () => {
      const root = document.documentElement;
      const surface = document.body ?? root;
      const styles = getComputedStyle(surface);
      const wallColor = styles.getPropertyValue('--wall-dark').trim();

      // Resolve color-mix()/var() values to a concrete browser-safe color.
      if (wallColor && document.body) {
        const probe = document.createElement('span');
        probe.style.cssText =
          'position:fixed;pointer-events:none;visibility:hidden;color:var(--wall-dark)';
        document.body.appendChild(probe);
        const resolved = getComputedStyle(probe).color;
        probe.remove();
        if (resolved) return resolved;
      }

      // Standalone pages such as the 404 do not use the room palette, so use
      // their own painted page surface instead.
      const bodyBackground = styles.backgroundColor;
      if (bodyBackground && bodyBackground !== 'rgba(0, 0, 0, 0)') {
        return bodyBackground;
      }

      return getComputedStyle(root).backgroundColor;
    };

    const updateThemeColor = () => {
      requestAnimationFrame(() => {
        const themeColor = resolveBrowserThemeColor();
        if (!themeColor) return;

        document
          .querySelectorAll('meta[name="theme-color"]')
          .forEach((meta) => meta.setAttribute('content', themeColor));
      });
    };

    applyTheme();

    if (!window.__cyrusThemeBootstrapInstalled) {
      window.__cyrusThemeBootstrapInstalled = true;

      document.addEventListener('astro:before-swap', (event) => {
        applyTheme(event.newDocument);
      });

      document.addEventListener('astro:after-swap', () => {
        applyTheme();
        updateThemeColor();
      });

      document.addEventListener('hecate:theme-change', updateThemeColor);

      document.addEventListener(
        'DOMContentLoaded',
        () => {
          applyTheme();
          updateThemeColor();
        },
        { once: true },
      );

      darkModeQuery.addEventListener('change', () => {
        if (readPreference()) return;
        applyTheme();
        updateThemeColor();
      });
    }
  })();
</script>
