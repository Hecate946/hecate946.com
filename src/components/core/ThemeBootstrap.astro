<meta name="theme-color" content="#ffffff" data-browser-theme-color />

<script is:inline>
  (() => {
    const THEME_STORAGE_KEY = 'color-theme';
    const themeNames = new Set(['light', 'dark']);
    const darkModeQuery = window.matchMedia('(prefers-color-scheme: dark)');
    const browserChromeColor = { light: '#ffffff', dark: '#000000' };

    const readPreference = () => {
      try {
        const saved = localStorage.getItem(THEME_STORAGE_KEY);
        return themeNames.has(saved) ? saved : null;
      } catch {
        return null;
      }
    };

    const resolveTheme = () => readPreference() ?? (darkModeQuery.matches ? 'dark' : 'light');

    const applyTheme = (targetDocument = document) => {
      const theme = resolveTheme();
      const root = targetDocument.documentElement;
      root.dataset.theme = theme;
      root.dataset.themeReady = 'true';
      root.style.colorScheme = theme;

      const themeColor = targetDocument.querySelector('[data-browser-theme-color]');
      themeColor?.setAttribute('content', browserChromeColor[theme]);
    };

    applyTheme();

    if (!window.__cyrusThemeBootstrapInstalled) {
      window.__cyrusThemeBootstrapInstalled = true;

      document.addEventListener('astro:before-swap', (event) => {
        applyTheme(event.newDocument);
      });

      document.addEventListener('astro:after-swap', () => {
        applyTheme();
      });

      document.addEventListener(
        'DOMContentLoaded',
        () => {
          applyTheme();
        },
        { once: true },
      );

      darkModeQuery.addEventListener('change', () => {
        if (readPreference()) return;
        applyTheme();
      });

      document.addEventListener('hecate:theme-change', () => {
        applyTheme();
      });
    }
  })();
</script>
