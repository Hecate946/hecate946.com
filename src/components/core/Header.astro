---
import { siteConfig } from '@/config/site';
import { headerNavigation } from '@/config/navigation';
import { isCurrentPath, withBase } from '@/lib/paths';
import ColorModeToggle from './ColorModeToggle.svelte';
import '@/styles/header.css';

const currentPath = Astro.url.pathname;

function isHeaderItemCurrent(item: (typeof headerNavigation)[number]) {
  return isCurrentPath(currentPath, item.href);
}
---

<header class="site-header">
  <div class="header-grid">
    <a
      class="brand"
      href={withBase('/')}
      aria-label={`${siteConfig.name} home`}
      data-astro-prefetch="load"
    >
      <span class="brand-full ui-text">{siteConfig.name}</span>
    </a>

    <nav class="primary-nav" aria-label="Primary navigation">
      <ul>
        {
          headerNavigation.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={isHeaderItemCurrent(item) ? 'page' : undefined}
                data-astro-prefetch="load"
              >
                <span class="ui-text">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mode-slot header-region" role="group" aria-label="Appearance">
      <ColorModeToggle client:idle />
    </div>
  </div>
</header>
<script is:inline>
  /**
   * Keep the scrolling-room header visually viewport-locked without using
   * position: fixed/sticky. Safari 26 treats fixed/sticky elements at the top
   * edge as a cue to paint a solid browser-chrome extension; an absolute
   * header translated by the document scroll preserves the intended visual
   * behavior while letting the real brick wall scroll underneath.
   */
  (() => {
    const property = '--absolute-nav-scroll-y';

    const sync = () => {
      const header = document.querySelector('.site-header');
      if (!header) return;

      if (!document.body.classList.contains('scrolling-primary-room')) {
        header.style.removeProperty(property);
        return;
      }

      // Safari may report negative/over-max scroll offsets while rubber-banding.
      // Preserve them so the absolute nav also stays visually stationary during
      // overscroll instead of moving with the document for a frame.
      const scrollY = window.scrollY || window.pageYOffset || 0;
      const dpr = window.devicePixelRatio || 1;
      const snappedScrollY = Math.round(scrollY * dpr) / dpr;
      header.style.setProperty(property, `${snappedScrollY}px`);
    };

    if (!window.__hecateAbsoluteNavSyncInstalled) {
      window.__hecateAbsoluteNavSyncInstalled = true;
      window.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync, { passive: true });
      window.visualViewport?.addEventListener('scroll', sync, { passive: true });
      window.visualViewport?.addEventListener('resize', sync, { passive: true });
      document.addEventListener('astro:page-load', sync);
      document.addEventListener('astro:after-swap', sync);
    }

    sync();
  })();
</script>
