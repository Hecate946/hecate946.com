---
import { siteConfig } from '@/config/site';
import { headerNavigation, type HeaderNavItem } from '@/config/navigation';
import { isCurrentPath, withBase } from '@/lib/paths';
import ColorModeToggle from '@/components/islands/ColorModeToggle.svelte';
import '@/styles/layout.css';
import '@/styles/header.css';

const currentPath = Astro.url.pathname;

function isHeaderItemCurrent(item: HeaderNavItem) {
  return isCurrentPath(currentPath, item.href);
}
---

<header class="site-header" transition:persist="site-header">
  <div class="header-grid">
    <a
      class="brand"
      href={withBase('/')}
      aria-label={`${siteConfig.name} home`}
      data-nav-route={withBase('/')}
      data-astro-prefetch
    >
      <span class="brand-full ui-text">{siteConfig.name}</span>
    </a>

    <nav class="primary-nav" aria-label="Primary navigation">
      <ul>
        {
          headerNavigation.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={isHeaderItemCurrent(item) ? 'page' : undefined}
                data-nav-route={withBase(item.href)}
                data-astro-prefetch
              >
                <span class="ui-text">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mode-slot header-region" role="group" aria-label="Appearance">
      <ColorModeToggle client:idle />
    </div>
  </div>
</header>
