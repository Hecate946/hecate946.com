<div class="mode-control" data-color-mode-control>
  <button
    type="button"
    class="header-action mode-action"
    aria-label="Toggle color mode"
    title="Toggle light and dark mode"
  >
    <span class="header-action-icon mode-icon" aria-hidden="true">
      <svg
        class="mode-sun"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"
        ></path>
      </svg>

      <svg
        class="mode-moon"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M20.2 15.25A8.5 8.5 0 0 1 8.75 3.8 8.5 8.5 0 1 0 20.2 15.25Z"></path>
      </svg>
    </span>
  </button>
</div>

<script>
  type ColorControlWindow = Window & {
    __hecateColorControlsInstalled?: boolean;
  };

  function initializeColorModeControls() {
    document
      .querySelectorAll<HTMLElement>(
        '[data-color-mode-control]:not([data-color-mode-ready])',
      )
      .forEach((control) => {
        control.dataset.colorModeReady = 'true';
        control.querySelector('button')?.addEventListener('click', () => {
          const root = document.documentElement;
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';

          root.dataset.theme = next;
          root.style.colorScheme = next;
          try {
            localStorage.setItem('color-theme', next);
          } catch {
            // The theme still applies when browser storage is unavailable.
          }

          document.dispatchEvent(new Event('hecate:theme-change'));
        });
      });
  }

  initializeColorModeControls();
  const colorControlWindow = window as ColorControlWindow;
  if (!colorControlWindow.__hecateColorControlsInstalled) {
    colorControlWindow.__hecateColorControlsInstalled = true;
    document.addEventListener('astro:page-load', initializeColorModeControls);
  }
</script>
