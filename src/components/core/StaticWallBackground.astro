---
import '@/styles/static-wall-background.css';
---

<div class="static-wall-background" aria-hidden="true" data-default-only>
  <div class="static-wall-background__wall-surface">
    <div class="static-wall-background__brick-pattern"></div>
  </div>

  <div class="static-wall-background__mortar-light"></div>

  <div class="static-wall-background__floor">
    <div class="static-wall-background__floor-surface"></div>
    <div class="static-wall-background__baseboard"></div>
  </div>

  <div class="static-wall-background__vignette"></div>
</div>
