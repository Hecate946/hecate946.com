---
import '@/styles/disclosure.css';

interface Props {
  class?: string;
  summaryClass?: string;
  open?: boolean;
}

const {
  class: className,
  summaryClass,
  open = false,
} = Astro.props;
---

<details
  class:list={['disclosure', className]}
  data-disclosure
  data-expanded={open ? '' : undefined}
  open={open}
>
  <summary class:list={['disclosure__summary', summaryClass]}>
    <slot name="summary" />
    <span class="disclosure__arrow" aria-hidden="true">
      <svg viewBox="0 0 32 32" focusable="false">
        <path d="M10 6 L22 16 L10 26" />
      </svg>
    </span>
  </summary>

  <div class="disclosure__body" data-disclosure-body>
    <div class="disclosure__content">
      <slot />
    </div>
  </div>
</details>

<script>
  import { installDisclosures } from '@/lib/disclosure';

  installDisclosures();
</script>
