---
import '@/styles/disclosure.css';

interface Props {
  class?: string;
  summaryClass?: string;
  open?: boolean;
}

const {
  class: className,
  summaryClass,
  open = false,
} = Astro.props;
---

<details class:list={['disclosure', className]} data-disclosure open={open}>
  <summary class:list={['disclosure__summary', summaryClass]}>
    <slot name="summary" />
    <span class="disclosure__arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false">
        <path d="M6 3l9 9-9 9" />
      </svg>
    </span>
  </summary>

  <div class="disclosure__body" data-disclosure-body>
    <slot />
  </div>
</details>

<script>
  import { installDisclosures } from '@/lib/disclosure';

  installDisclosures();
</script>
