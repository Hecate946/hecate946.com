---
import { headerNavigation } from '@/config/navigation';
import { htmlSiteRoutes } from '@/lib/site-routes';
import { withBase } from '@/lib/paths';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const normalizePath = (value: string) => {
  const normalized = value.replace(/\/+$/, '');
  return normalized === '' ? '/' : normalized;
};

const isHome = normalizePath(currentPath) === normalizePath(withBase('/'));
const routeHref = (href: string) =>
  href === '/404.html' ? withBase('/404.html') : withBase(href);
---

{
  isHome ? (
    <section data-html-only hidden aria-label="HTML mode site index">
      <header>
        <h1>hecate946.com</h1>
        <p>Cyrus Asasi</p>
        <p>software engineer + classical musician</p>
      </header>

      <nav aria-label="Primary site navigation">
        <h2>Navigation</h2>
        <ul>
          {headerNavigation.map((page) => (
            <li>
              <a href={withBase(page.href)} data-astro-prefetch>
                {page.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <section aria-labelledby="all-routes-heading">
        <h2 id="all-routes-heading">All routes</h2>
        <table>
          <thead>
            <tr>
              <th scope="col">Path</th>
              <th scope="col">Page</th>
              <th scope="col">Description</th>
            </tr>
          </thead>
          <tbody>
            {htmlSiteRoutes.map((route) => (
              <tr>
                <td>
                  <code>{route.href}</code>
                </td>
                <td>
                  <a href={routeHref(route.href)} data-astro-prefetch>
                    {route.label}
                  </a>
                </td>
                <td>{route.description ?? ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <nav aria-label="External links">
        <h2>External</h2>
        <ul>
          <li><a href="mailto:cyrusasasi@gmail.com">Email</a></li>
          <li>
            <a
              href="https://github.com/Hecate946/"
              target="_blank"
              rel="me noopener noreferrer"
            >GitHub</a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/cyrus-asasi/"
              target="_blank"
              rel="me noopener noreferrer"
            >LinkedIn</a>
          </li>
          <li>
            <a
              href="https://buymeacoffee.com/hecate946"
              target="_blank"
              rel="noopener noreferrer"
            >Buy me a coffee</a>
          </li>
        </ul>
      </nav>

      <section aria-labelledby="html-settings-heading">
        <h2 id="html-settings-heading">Settings</h2>
        <p>
          <button
            type="button"
            aria-label="Enable sounds"
            aria-pressed="false"
            data-label="Enable sounds"
            data-sound-toggle
          >
            <span data-sound-toggle-text>Enable sounds</span>
          </button>
        </p>
        <p>
          <button
            type="button"
            aria-label="Return to standard site"
            aria-pressed="true"
            data-label="Return to standard site"
            data-html-mode-toggle
          >
            <span data-html-mode-text>Return to standard site</span>
          </button>
        </p>
      </section>
    </section>
  ) : (
    <nav data-html-only hidden aria-label="HTML mode controls">
      <a href={withBase('/')} data-astro-prefetch>Home</a>
      {' | '}
      <code>{currentPath}</code>
      {' | '}
      <button
        type="button"
        aria-label="Return to standard site"
        aria-pressed="true"
        data-label="Return to standard site"
        data-html-mode-toggle
      >
        <span data-html-mode-text>Return to standard site</span>
      </button>
      <hr />
    </nav>
  )
}
