---
import RenderedWorld from '@/components/world/RenderedWorld.svelte';
import { withBase } from '@/lib/paths';

const manifestUrl = withBase('/scenes/world/manifest.json');
---

<section class="home-display" aria-labelledby="home-title">
  <h1 id="home-title" class="visually-hidden">Cyrus Asasi</h1>
  <div class="home-display__stage">
    <RenderedWorld client:load {manifestUrl} />
  </div>
</section>
