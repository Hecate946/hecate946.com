---
import { pdfViewerHref, withBase } from '@/lib/paths';

const resumes = [
  {
    id: 'software',
    fullTitle: 'Software Engineering Resume',
    pdf: '/resumes/cyrus-asasi-software-engineering-resume.pdf',
    preview: '/images/resume/cyrus-asasi-software-engineering-resume-480.webp',
    preview720:
      '/images/resume/cyrus-asasi-software-engineering-resume-720.webp',
    alt: 'Cyrus Asasi’s software engineering resume',
  },
  {
    id: 'clarinet',
    fullTitle: 'Clarinet Performance Resume',
    pdf: '/resumes/cyrus-asasi-clarinet-performance-resume.pdf',
    preview: '/images/resume/cyrus-asasi-clarinet-performance-resume-480.webp',
    preview720:
      '/images/resume/cyrus-asasi-clarinet-performance-resume-720.webp',
    alt: 'Cyrus Asasi’s clarinet performance resume',
  },
] as const;
---

<section class="resume-scrolls" aria-label="Resumes">
  <div class="resume-scrolls__grid">
    {
      resumes.map((resume) => (
        <article
          class={`about-scroll-paper resume-scroll resume-scroll--${resume.id}`}
          aria-label={resume.fullTitle}
        >
          <div
            class="about-scroll-paper__roll about-scroll-paper__roll--top"
            aria-hidden="true"
          />

          <div class="about-scroll-paper__sheet resume-scroll__sheet">
            <a
              class="resume-scroll__document"
              href={pdfViewerHref(resume.pdf)}
              aria-label={`View ${resume.fullTitle}`}
              data-astro-prefetch
            >
              <picture>
                <source
                  media="(max-width: 32rem)"
                  srcset={withBase(resume.preview)}
                />
                <img
                  src={withBase(resume.preview720)}
                  alt={resume.alt}
                  width="720"
                  height="1018"
                  draggable="false"
                  decoding="async"
                />
              </picture>
            </a>
          </div>

          <div
            class="about-scroll-paper__roll about-scroll-paper__roll--bottom"
            aria-hidden="true"
          />
        </article>
      ))
    }
  </div>
</section>
