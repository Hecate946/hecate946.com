---
import { pdfViewerHref, withBase } from '@/lib/paths';

const resumes = [
  {
    id: 'software',
    eyebrow: 'Software Engineering',
    fullTitle: 'Software Engineering Resume',
    pdf: '/resumes/cyrus-asasi-software-engineering-resume.pdf',
    preview: '/images/resume/cyrus-asasi-software-engineering-resume-480.webp',
    preview720: '/images/resume/cyrus-asasi-software-engineering-resume-720.webp',
    alt: 'Preview of Cyrus Asasi’s software engineering resume',
  },
  {
    id: 'clarinet',
    eyebrow: 'Clarinet Performance',
    fullTitle: 'Clarinet Performance Resume',
    pdf: '/resumes/cyrus-asasi-clarinet-performance-resume.pdf',
    preview: '/images/resume/cyrus-asasi-clarinet-performance-resume-480.webp',
    preview720: '/images/resume/cyrus-asasi-clarinet-performance-resume-720.webp',
    alt: 'Preview of Cyrus Asasi’s clarinet performance resume',
  },
] as const;
---

<section class="resume-gallery" aria-label="Resumes">
  <div class="resume-gallery__wall-zone">
    <div class="resume-gallery__grid" aria-label="Resume choices">
      {resumes.map((resume, index) => (
        <article class={`resume-card resume-card--${resume.id}`}>
          <a
            class="resume-card__frame"
            href={pdfViewerHref(resume.pdf)}
            aria-label={`View ${resume.fullTitle}`}
            data-astro-prefetch
          >
            <span class="resume-card__glass">
              <img
                src={withBase(resume.preview)}
                srcset={`${withBase(resume.preview)} 480w, ${withBase(resume.preview720)} 720w`}
                sizes="(max-width: 21rem) calc(100vw - 2rem), 304px"
                alt={resume.alt}
                width="480"
                height="676"
                draggable="false"
                decoding="async"
              />
              <span class="resume-card__shade" aria-hidden="true"></span>
              <span class="resume-card__reflection" aria-hidden="true"></span>
            </span>
            <span class="resume-card__sill" aria-hidden="true"></span>
          </a>

          <div class="resume-card__caption">
            <a
              class="resume-card__label"
              href={pdfViewerHref(resume.pdf)}
              aria-label={`View ${resume.fullTitle}`}
              data-astro-prefetch
            >
              <span class="resume-card__index">{String(index + 1).padStart(2, '0')}</span>
              <span class="resume-card__name">{resume.eyebrow}</span>
              <span class="resume-card__arrow" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="16" height="16" focusable="false">
                  <path d="M4 12 12 4M6.25 4H12v5.75" />
                </svg>
              </span>
            </a>

            <div class="resume-card__actions" aria-label={`${resume.eyebrow} resume actions`}>
              <a href={pdfViewerHref(resume.pdf)} data-astro-prefetch>
                <span>View resume</span>
                <span class="resume-card__action-icon" aria-hidden="true">↗</span>
              </a>
              <span class="resume-card__action-separator" aria-hidden="true">·</span>
              <a href={withBase(resume.pdf)} download>
                <span>Download PDF</span>
                <span class="resume-card__action-icon" aria-hidden="true">↓</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
