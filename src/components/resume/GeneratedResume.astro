---
interface Props {
  html: string;
  label: string;
  variant?: 'clarinet' | 'software';
}

const { html, label, variant = 'clarinet' } = Astro.props;
const bodyMatch = html.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
const rawBodyHtml = bodyMatch?.[1] ?? html;
const bodyHtml = rawBodyHtml.replace(
  /(<a\b[^>]*href=[\"']mailto:[^>]+>[\s\S]*?<\/a>)/gi,
  '<!--email_off-->$1<!--/email_off-->',
);
---

<div
  class={`generated-resume generated-resume--${variant}`}
  aria-label={label}
  set:html={bodyHtml}
/>
