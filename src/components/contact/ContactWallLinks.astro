---
import { withBase } from '@/lib/paths';

type ContactWallLink = {
  id: 'email' | 'github' | 'linkedin' | 'coffee' | 'chess' | 'spotify';
  label: string;
  href: string;
  imageSrc: string;
  target?: '_blank';
  rel?: string;
};

const links: ContactWallLink[] = [
  {
    id: 'email',
    label: 'Email',
    href: 'mailto:cyrusasasi@gmail.com',
    imageSrc: '/images/contact/buttons/email.png',
  },
  {
    id: 'github',
    label: 'GitHub',
    href: 'https://github.com/Hecate946/',
    imageSrc: '/images/contact/buttons/github.png',
    target: '_blank',
    rel: 'me noopener noreferrer',
  },
  {
    id: 'linkedin',
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/cyrus-asasi/',
    imageSrc: '/images/contact/buttons/linkedin.png',
    target: '_blank',
    rel: 'me noopener noreferrer',
  },
  {
    id: 'coffee',
    label: 'Buy Me a Coffee',
    href: 'https://buymeacoffee.com/hecate946',
    imageSrc: '/images/contact/buttons/coffee.png',
    target: '_blank',
    rel: 'noopener noreferrer',
  },
  {
    id: 'chess',
    label: 'Chess.com',
    href: 'https://www.chess.com/member/Cyrus2020SD/stats?time=0',
    imageSrc: '/images/contact/buttons/chess.png',
    target: '_blank',
    rel: 'noopener noreferrer',
  },
  {
    id: 'spotify',
    label: 'Spotify',
    href: 'https://open.spotify.com/user/hecate946',
    imageSrc: '/images/contact/buttons/spotify.png',
    target: '_blank',
    rel: 'noopener noreferrer',
  },
];
---

<nav class="contact-wall-links" data-random-contact-wall aria-label="Contact and profile links">
  {links.map((link) => (
    <a
      class={`contact-icon-link contact-icon-link--${link.id}`}
      href={link.href}
      target={link.target}
      rel={link.rel}
      aria-label={link.label}
      draggable="false"
      data-random-contact-item
    >
      <img
        class="contact-icon-link__image"
        src={withBase(link.imageSrc)}
        alt=""
        width="240"
        height="240"
        draggable="false"
        decoding="async"
      />
      <span class="contact-icon-link__label">{link.label}</span>
    </a>
  ))}
</nav>

<script is:inline>
  (() => {
    const randomInRange = (min, max) => min + Math.random() * (max - min);
    const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

    const placeWall = (wall) => {
      if (!(wall instanceof HTMLElement)) return;
      const items = Array.from(wall.querySelectorAll('[data-random-contact-item]'));
      if (!items.length) return;

      const wallRect = wall.getBoundingClientRect();
      const sampleRect = items[0].getBoundingClientRect();
      const itemSize = Math.max(sampleRect.width || 80, sampleRect.height || 80);
      const padding = Math.max(10, itemSize * 0.14);
      const minX = padding;
      const maxX = Math.max(minX, wallRect.width - itemSize - padding);
      const minY = padding;
      const maxY = Math.max(minY, wallRect.height - itemSize - padding);
      const requiredSpacing = itemSize * 1.52;
      const placed = [];

      items.forEach((item) => {
        if (!(item instanceof HTMLElement)) return;
        let x = minX;
        let y = minY;
        let tries = 0;

        while (tries < 900) {
          x = randomInRange(minX, maxX);
          y = randomInRange(minY, maxY);

          const overlaps = placed.some((spot) => {
            return Math.abs(x - spot.x) < requiredSpacing && Math.abs(y - spot.y) < requiredSpacing;
          });

          if (!overlaps) break;
          tries += 1;
        }

        placed.push({ x, y });
        item.style.left = `${x}px`;
        item.style.top = `${y}px`;
        item.style.setProperty('--contact-rotation', `${randomInRange(-180, 180).toFixed(2)}deg`);
      });
    };

    const enableDragging = (wall) => {
      if (!(wall instanceof HTMLElement) || wall.dataset.dragReady === 'true') return;
      wall.dataset.dragReady = 'true';

      wall.querySelectorAll('[data-random-contact-item]').forEach((item) => {
        if (!(item instanceof HTMLElement)) return;

        let pointerId = null;
        let startPointerX = 0;
        let startPointerY = 0;
        let startLeft = 0;
        let startTop = 0;
        let didDrag = false;
        let suppressNextClick = false;

        item.addEventListener('dragstart', (event) => {
          event.preventDefault();
        });

        item.addEventListener('pointerdown', (event) => {
          if (event.button !== 0) return;
          pointerId = event.pointerId;
          startPointerX = event.clientX;
          startPointerY = event.clientY;
          startLeft = Number.parseFloat(item.style.left) || item.offsetLeft;
          startTop = Number.parseFloat(item.style.top) || item.offsetTop;
          didDrag = false;
          item.classList.add('is-pointer-down');
          item.setPointerCapture(pointerId);
        });

        item.addEventListener('pointermove', (event) => {
          if (pointerId !== event.pointerId) return;

          const deltaX = event.clientX - startPointerX;
          const deltaY = event.clientY - startPointerY;

          if (!didDrag && Math.hypot(deltaX, deltaY) < 6) return;
          event.preventDefault();
          didDrag = true;
          item.classList.add('is-dragging');

          const wallRect = wall.getBoundingClientRect();
          const itemRect = item.getBoundingClientRect();
          const itemWidth = item.offsetWidth || itemRect.width;
          const itemHeight = item.offsetHeight || itemRect.height;
          const candidateLeft = clamp(startLeft + deltaX, 0, Math.max(0, wallRect.width - itemWidth));
          const candidateTop = clamp(startTop + deltaY, 0, Math.max(0, wallRect.height - itemHeight));
          const candidateCenterX = candidateLeft + itemWidth / 2;
          const candidateCenterY = candidateTop + itemHeight / 2;
          const collisionSpacing = Math.max(itemWidth, itemHeight) * 1.48;

          const collides = Array.from(wall.querySelectorAll('[data-random-contact-item]')).some((other) => {
            if (!(other instanceof HTMLElement) || other === item) return false;
            const otherLeft = Number.parseFloat(other.style.left) || other.offsetLeft;
            const otherTop = Number.parseFloat(other.style.top) || other.offsetTop;
            const otherCenterX = otherLeft + other.offsetWidth / 2;
            const otherCenterY = otherTop + other.offsetHeight / 2;
            return (
              Math.abs(candidateCenterX - otherCenterX) < collisionSpacing &&
              Math.abs(candidateCenterY - otherCenterY) < collisionSpacing
            );
          });

          if (!collides) {
            item.style.left = `${candidateLeft}px`;
            item.style.top = `${candidateTop}px`;
          }
        });

        const finishPointer = (event) => {
          if (pointerId !== event.pointerId) return;
          if (item.hasPointerCapture(pointerId)) item.releasePointerCapture(pointerId);
          pointerId = null;
          item.classList.remove('is-pointer-down');
          item.classList.remove('is-dragging');

          if (didDrag) {
            suppressNextClick = true;
            window.setTimeout(() => {
              suppressNextClick = false;
            }, 350);
            queueMicrotask(() => {
              didDrag = false;
            });
          }
        };

        item.addEventListener('pointerup', finishPointer);
        item.addEventListener('pointercancel', finishPointer);

        item.addEventListener('click', (event) => {
          if (!suppressNextClick) return;
          event.preventDefault();
          event.stopPropagation();
          suppressNextClick = false;
        });
      });
    };

    const initRandomContacts = () => {
      document.querySelectorAll('[data-random-contact-wall]').forEach((wall) => {
        if (!(wall instanceof HTMLElement)) return;
        requestAnimationFrame(() => {
          if (wall.dataset.randomized !== 'true') {
            placeWall(wall);
            wall.dataset.randomized = 'true';
          }
          enableDragging(wall);
        });
      });
    };

    document.addEventListener('astro:page-load', initRandomContacts);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRandomContacts, { once: true });
    } else {
      initRandomContacts();
    }
  })();
</script>
