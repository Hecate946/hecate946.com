---
import { withBase } from '@/lib/paths';

type ContactLink = {
  id: 'email' | 'github' | 'linkedin' | 'coffee';
  label: string;
  hint: string;
  href: string;
  target?: '_blank';
  rel?: string;
  icon: string;
};

// The silhouettes stay vector-sharp while a shared SVG filter gives every
// mark a slightly dusty, imperfect chalk edge. The white tile itself remains
// perfectly consistent so all four contact buttons share one radius/size.
const icons = {
  email: String.raw`<svg viewBox="0 0 24 24" role="presentation" aria-hidden="true">
    <rect class="chalk-icon-stroke" x="3.25" y="5.65" width="17.5" height="12.7" rx="1.2" />
    <path class="chalk-icon-stroke" d="m4.5 7 7.5 6.1L19.5 7M4.45 17l5.25-5.05M19.55 17l-5.25-5.05" />
  </svg>`,
  github: String.raw`<svg viewBox="0 0 24 24" role="presentation" aria-hidden="true">
    <path class="chalk-icon-fill" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
  </svg>`,
  linkedin: String.raw`<svg viewBox="0 0 24 24" role="presentation" aria-hidden="true">
    <circle class="chalk-icon-fill" cx="5.35" cy="5.5" r="2.15" />
    <path class="chalk-icon-fill" d="M3.55 9.3h3.6v11.15h-3.6zM9.45 9.3h3.45v1.52h.05c.48-.91 1.66-1.88 3.42-1.88 3.66 0 4.33 2.41 4.33 5.55v5.96h-3.6v-5.28c0-1.26-.02-2.88-1.76-2.88-1.76 0-2.03 1.37-2.03 2.79v5.37h-3.6V9.3z" />
  </svg>`,
  coffee: String.raw`<svg viewBox="0 0 24 24" role="presentation" aria-hidden="true">
    <path class="chalk-icon-accent" d="M6.7 9.35h10.6l-1.15 10.1a2 2 0 0 1-1.99 1.78H9.84a2 2 0 0 1-1.99-1.78L6.7 9.35Z" />
    <path class="chalk-icon-stroke" d="M7.1 9.35h9.8M6.4 6.15h11.2l.55 3.2H5.85l.55-3.2ZM8.15 3.45c1.15-.4 2.43-.6 3.85-.6 1.43 0 2.72.2 3.85.6l.4 2.7h-8.5l.4-2.7Z" />
  </svg>`,
};

const links: ContactLink[] = [
  {
    id: 'email',
    label: 'Mail',
    hint: 'say hello',
    href: 'mailto:cyrusasasi@gmail.com',
    icon: icons.email,
  },
  {
    id: 'github',
    label: 'GitHub',
    hint: 'see my code',
    href: 'https://github.com/Hecate946/',
    target: '_blank',
    rel: 'me noopener noreferrer',
    icon: icons.github,
  },
  {
    id: 'linkedin',
    label: 'LinkedIn',
    hint: "let's connect",
    href: 'https://www.linkedin.com/in/cyrus-asasi/',
    target: '_blank',
    rel: 'me noopener noreferrer',
    icon: icons.linkedin,
  },
  {
    id: 'coffee',
    label: 'Buy coffee',
    hint: 'support me ♡',
    href: 'https://buymeacoffee.com/hecate946',
    target: '_blank',
    rel: 'noopener noreferrer',
    icon: icons.coffee,
  },
];
---

<div class="contact-chalkboard-wrap">
  <svg class="contact-chalkboard__filters" aria-hidden="true" focusable="false">
    <filter id="contact-chalk-rough" x="-28%" y="-28%" width="156%" height="156%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.78 0.46" numOctaves="3" seed="17" result="edgeNoise" />
      <feDisplacementMap
        in="SourceGraphic"
        in2="edgeNoise"
        scale="0.95"
        xChannelSelector="R"
        yChannelSelector="G"
        result="wobbled"
      />
      <feTurbulence type="fractalNoise" baseFrequency="1.15" numOctaves="4" seed="29" result="chalkNoise" />
      <feColorMatrix in="chalkNoise" type="luminanceToAlpha" result="chalkLuma" />
      <feComponentTransfer in="chalkLuma" result="chalkMask">
        <feFuncA type="table" tableValues="0.12 0.38 0.68 0.96" />
      </feComponentTransfer>
      <feComposite in="wobbled" in2="chalkMask" operator="in" result="grainyStroke" />
      <feGaussianBlur in="wobbled" stdDeviation="0.42" result="softDust" />
      <feComponentTransfer in="softDust" result="faintDust">
        <feFuncA type="linear" slope="0.13" />
      </feComponentTransfer>
      <feBlend in="grainyStroke" in2="faintDust" mode="screen" />
    </filter>
  </svg>

  <div class="contact-chalkboard__recess">
    <div class="contact-chalkboard__glass">
      <div class="contact-chalkboard" aria-label="Contact links chalkboard">
        <img
          class="contact-chalkboard__texture"
          src={withBase('/images/contact/chalkboard-photo.webp')}
          alt=""
          width="1600"
          height="1000"
          draggable="false"
          decoding="async"
        />
        <div class="contact-chalkboard__drawing-layer" data-chalk-drawing-layer aria-hidden="true"></div>

        <nav class="contact-chalkboard__links" aria-label="Contact and profile links">
          {links.map((link) => {
            const hintId = `contact-${link.id}-hint`;
            return (
              <a
                class={`chalk-link chalk-link--${link.id}`}
                href={link.href}
                target={link.target}
                rel={link.rel}
                aria-label={link.label}
                aria-describedby={hintId}
              >
                <span class="chalk-link__mark" aria-hidden="true" set:html={link.icon} />
                <span class="chalk-link__label">{link.label}</span>
                <span class="chalk-link__hint" id={hintId}>{link.hint}</span>
              </a>
            );
          })}
        </nav>
      </div>
    </div>
  </div>

  <div class="contact-chalkboard__sill" aria-hidden="true"></div>
</div>
