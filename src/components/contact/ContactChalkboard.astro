---
import { siteConfig } from '@/config/site';
import { withBase } from '@/lib/paths';

const socialLinks = [
  {
    id: 'github',
    label: 'GitHub',
    detail: '@Hecate946',
    href: siteConfig.social.github,
    rel: 'me noopener noreferrer',
    icon: String.raw`<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.4 11.4 0 0 0-3.6 22.2c.57.1.78-.25.78-.55v-2.18c-3.18.7-3.85-1.35-3.85-1.35-.52-1.32-1.27-1.67-1.27-1.67-1.04-.7.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.54-.29-5.21-1.27-5.21-5.66 0-1.25.44-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.03 0 0 .96-.3 3.14 1.17a10.9 10.9 0 0 1 5.72 0c2.18-1.48 3.13-1.17 3.13-1.17.63 1.58.24 2.74.12 3.03.73.8 1.17 1.82 1.17 3.07 0 4.4-2.68 5.36-5.23 5.65.41.36.78 1.05.78 2.12v3.14c0 .3.2.66.79.55A11.4 11.4 0 0 0 12 .7Z"/></svg>`,
  },
  {
    id: 'linkedin',
    label: 'LinkedIn',
    detail: 'Cyrus Asasi',
    href: siteConfig.social.linkedin,
    rel: 'me noopener noreferrer',
    icon: String.raw`<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.3 7.9A2.2 2.2 0 1 0 5.3 3.5a2.2 2.2 0 0 0 0 4.4ZM3.45 9.55h3.7V20.5h-3.7V9.55Zm5.8 0h3.54v1.5h.05c.49-.93 1.7-1.9 3.5-1.9 3.75 0 4.44 2.47 4.44 5.68v5.67h-3.69v-5.03c0-1.2-.02-2.75-1.68-2.75-1.68 0-1.94 1.31-1.94 2.66v5.12H9.25V9.55Z"/></svg>`,
  },
  {
    id: 'coffee',
    label: 'Buy me a coffee',
    detail: 'Support the experiments',
    href: siteConfig.social.buyMeACoffee,
    rel: 'noopener noreferrer',
  },
] as const;

const topics = [
  ['Software opportunity', 'Software opportunity'],
  ['Music collaboration', 'Music collaboration'],
  ['Creative project', 'Creative project'],
  ['Just saying hello', 'Just saying hello'],
] as const;
---

<div class="contact-station">
  <form
    class="contact-compose contact-panel"
    action={`mailto:${siteConfig.email}`}
    method="get"
    data-contact-compose
    data-email={siteConfig.email}
  >
    <section
      class="contact-compose__email"
      aria-labelledby="contact-email-label"
    >
      <p class="contact-kicker" id="contact-email-label">Email</p>
      <div class="contact-email-row">
        <!--email_off-->
        <a class="contact-email-address" href="#" data-contact-email-link
          >{siteConfig.email}</a
        >
        <!--/email_off-->
        <button
          class="contact-copy"
          type="button"
          data-contact-copy
          aria-label="Copy email address"
        >
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <rect x="6.1" y="5.7" width="8.2" height="8.2" rx="1.25"></rect>
            <path
              d="M5.4 11.8H4.8a1.6 1.6 0 0 1-1.6-1.6V4.8a1.6 1.6 0 0 1 1.6-1.6h5.4a1.6 1.6 0 0 1 1.6 1.6v.6"
            ></path>
          </svg>
          <span data-contact-copy-label>Copy</span>
        </button>
      </div>
    </section>

    <div class="contact-rule" aria-hidden="true"></div>

    <fieldset class="contact-topics">
      <legend>What are we talking about?</legend>
      <div class="contact-topic-grid">
        {
          topics.map(([label, value], index) => (
            <label class="contact-topic">
              <input
                type="radio"
                name="subject"
                value={value}
                checked={index === 0}
              />
              <span class="contact-topic__dot" aria-hidden="true" />
              <span>{label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <label class="contact-note">
      <span>A quick note</span>
      <textarea
        name="body"
        rows="4"
        placeholder="Tell me a little about what you have in mind..."
        aria-label="A quick note"></textarea>
    </label>

    <button class="contact-compose-button" type="submit">
      <span>Compose email</span>
      <span class="contact-compose-button__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 16" focusable="false">
          <path d="M1.5 14.5 15 1M7 1h8v8"></path>
        </svg>
      </span>
    </button>
  </form>

  <nav class="contact-social-grid" aria-label="Other ways to connect">
    {
      socialLinks.map((link) => (
        <a
          class={`contact-social-card contact-panel contact-social-card--${link.id}`}
          href={link.href}
          target="_blank"
          rel={link.rel}
          draggable="false"
        >
          {link.id === 'coffee' ? (
            <span class="contact-social-card__cup" aria-hidden="true">
              <img
                src={withBase('/images/contact/buy-me-a-coffee-cup.png')}
                alt=""
                width="252"
                height="360"
                decoding="async"
                draggable="false"
              />
            </span>
          ) : (
            <span
              class="contact-social-card__icon"
              aria-hidden="true"
              set:html={link.icon}
            />
          )}
          <span class="contact-social-card__title">{link.label}</span>
          <span class="contact-social-card__detail">{link.detail}</span>
          <span class="contact-social-card__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 16" focusable="false">
              <path d="M1.5 14.5 15 1M7 1h8v8"></path>
            </svg>
          </span>
        </a>
      ))
    }
  </nav>
</div>

<script>
  const setupContactStation = () => {
    document
      .querySelectorAll<HTMLFormElement>('[data-contact-compose]')
      .forEach((form) => {
        if (form.dataset.contactBound === 'true') return;
        form.dataset.contactBound = 'true';

        const email = form.dataset.email ?? '';
        const emailLink = form.querySelector<HTMLAnchorElement>(
          '[data-contact-email-link]',
        );
        const copyButton = form.querySelector<HTMLButtonElement>(
          '[data-contact-copy]',
        );
        const copyLabel = form.querySelector<HTMLElement>(
          '[data-contact-copy-label]',
        );
        let copyResetTimer = 0;

        if (emailLink && email) {
          emailLink.href = `mailto:${email}`;
        }

        copyButton?.addEventListener('click', async () => {
          if (!copyLabel || !email) return;

          let copied = false;
          if (navigator.clipboard?.writeText) {
            try {
              await navigator.clipboard.writeText(email);
              copied = true;
            } catch {
              // Clipboard access can be denied by the browser or page permissions.
            }
          }

          window.clearTimeout(copyResetTimer);
          copyLabel.textContent = copied ? 'Copied' : 'Unavailable';
          copyButton.dataset.copied = copied ? 'true' : 'false';
          copyResetTimer = window.setTimeout(
            () => {
              copyLabel.textContent = 'Copy';
              delete copyButton.dataset.copied;
            },
            copied ? 1400 : 2200,
          );
        });

        form.addEventListener('submit', (event) => {
          if (!email) return;
          event.preventDefault();

          const data = new FormData(form);
          const subject = String(data.get('subject') ?? 'Hello');
          const body = String(data.get('body') ?? '').trim();
          const params = new URLSearchParams({ subject });
          if (body) params.set('body', body);

          window.location.href = `mailto:${email}?${params.toString()}`;
        });
      });
  };

  setupContactStation();
  document.addEventListener('astro:page-load', setupContactStation);
</script>
