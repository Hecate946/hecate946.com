---
import BaseHead from '@/components/core/BaseHead.astro';
import ThemeBootstrap from '@/components/core/ThemeBootstrap.astro';
import RenderedWorld from '@/components/world/RenderedWorld.svelte';
import { withBase } from '@/lib/paths';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  viewId: string;
  backHref?: string;
  backLabel?: string;
  interactive?: boolean;
}

const {
  title,
  description,
  viewId,
  backHref = '/',
  backLabel = 'Go back home',
  interactive = false,
} = Astro.props;

const manifestUrl = withBase('/scenes/world/manifest.json');
const resolvedBackHref = withBase(backHref);
const plainTitle = title.split('|')[0].trim();
---

<!doctype html>
<html
  lang="en-US"
  data-season="summer"
  data-season-preference="auto"
  data-theme="light"
  data-html-mode="false"
>
  <head>
    <ThemeBootstrap />
    <BaseHead {title} {description} />
  </head>

  <body class="room-view-page">
    <main id="main-content" class="room-view-shell">
      <header class="visually-hidden">
        <h1>{plainTitle}</h1>
        <p>{description}</p>
      </header>

      <div class="room-view-scene">
        <RenderedWorld
          client:load
          {manifestUrl}
          startViewId={viewId}
          fillViewport
          showHotspots={interactive}
        />
      </div>

      <a class="room-view-back" href={resolvedBackHref}>{backLabel}</a>
    </main>

    <script>
      import { initializeHtmlMode } from '@/lib/html-mode';
      initializeHtmlMode();
    </script>
  </body>
</html>

<style is:global>
  html,
  body.room-view-page {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #020202;
  }

  body.room-view-page::after {
    display: none;
  }

  body.room-view-page #main-content.room-view-shell {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .room-view-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .room-view-back {
    position: absolute;
    z-index: 10;
    top: max(0.8rem, env(safe-area-inset-top));
    left: max(0.8rem, env(safe-area-inset-left));
    display: inline-flex;
    min-height: 2.3rem;
    align-items: center;
    justify-content: center;
    padding: 0.46rem 0.72rem;
    border: 1px solid color-mix(in srgb, var(--text) 28%, transparent);
    border-radius: 0.42rem;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    color: var(--text) !important;
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 400;
    line-height: 1;
    text-decoration: none;
    backdrop-filter: blur(8px);
  }

  .room-view-back:hover,
  .room-view-back:focus-visible {
    border-color: color-mix(in srgb, var(--text) 48%, transparent);
    color: var(--text) !important;
    transform: none;
  }
</style>
