---
import BaseHead from '@/components/core/BaseHead.astro';
import Header from '@/components/core/Header.astro';
import SkipLink from '@/components/core/SkipLink.astro';
import ThemeBootstrap from '@/components/core/ThemeBootstrap.astro';
import WallBackdrop from '@/features/wall/WallBackdrop.svelte';
import FloorScene from '@/features/floor/FloorScene.svelte';
import { ClientRouter } from 'astro:transitions';
import { siteConfig } from '@/config/site';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  mainClass?: string;
  bodyClass?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  imageType,
  mainClass,
  bodyClass,
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const isDedicatedRoom =
  pathname === '/' ||
  pathname === '/about/' ||
  pathname === '/about' ||
  pathname === '/projects/' ||
  pathname === '/projects';
const roomThemeClass = pathname.startsWith('/projects')
  ? 'room-theme-projects'
  : pathname.startsWith('/resumes')
    ? 'room-theme-resume'
    : pathname.startsWith('/contact')
      ? 'room-theme-contact'
      : pathname.startsWith('/stats')
        ? 'room-theme-stats'
        : undefined;

const elevatorTabAnimationsEnabled = siteConfig.ui.enableElevatorTabAnimations;
const clientRouterFallback = elevatorTabAnimationsEnabled ? 'animate' : 'swap';

const roomLiftTransition = {
  forwards: {
    old: {
      name: 'room-lift-out',
      duration: '1250ms',
      easing: 'linear',
      fillMode: 'both',
    },
    new: {
      name: 'room-rise-in',
      duration: '1250ms',
      easing: 'linear',
      fillMode: 'both',
    },
  },
  backwards: {
    old: {
      name: 'room-drop-out',
      duration: '1250ms',
      easing: 'linear',
      fillMode: 'both',
    },
    new: {
      name: 'room-descend-in',
      duration: '1250ms',
      easing: 'linear',
      fillMode: 'both',
    },
  },
};
---

<!doctype html>
<html
  lang="en-US"
  data-theme="light"
  data-elevator-tab-animations={elevatorTabAnimationsEnabled ? 'on' : 'off'}
  transition:name="root"
  transition:animate={
    elevatorTabAnimationsEnabled
      ? roomLiftTransition
      : {
          forwards: {
            old: { name: 'none', duration: '1ms', easing: 'linear', fillMode: 'both' },
            new: { name: 'none', duration: '1ms', easing: 'linear', fillMode: 'both' },
          },
          backwards: {
            old: { name: 'none', duration: '1ms', easing: 'linear', fillMode: 'both' },
            new: { name: 'none', duration: '1ms', easing: 'linear', fillMode: 'both' },
          },
        }
  }
>
  <head>
    <ThemeBootstrap />
    <BaseHead {title} {description} {image} {imageAlt} {imageWidth} {imageHeight} {imageType} {noindex} />
    <slot name="head" />
    <ClientRouter fallback={clientRouterFallback} />
  </head>

  <body class:list={[bodyClass, roomThemeClass]}>
    {!isDedicatedRoom && (
      <div class="site-room-backdrop wall-room-host" aria-hidden="true">
        <WallBackdrop />
        <FloorScene client:load />
      </div>
    )}
    <SkipLink />
    <Header />

    <main id="main-content" class={mainClass}>
      <slot />
    </main>

    <script>
      import type { TransitionBeforePreparationEvent } from 'astro:transitions/client';

      const elevatorTabAnimationsEnabled =
        document.documentElement.dataset.elevatorTabAnimations === 'on';

      // Primary room order: Home → About → Projects → Resumes → Contact.
      // Moving right reveals the room below; moving left reveals the room above.
      const orderedRoomRoutes = ['/', '/about', '/projects', '/resumes', '/contact'] as const;

      const normalizePath = (pathname: string) => {
        if (pathname === '/') return '/';
        return pathname.replace(/\/+$/, '');
      };

      const getRoomRouteIndex = (pathname: string) => {
        const normalizedPath = normalizePath(pathname);
        if (normalizedPath === '/') return 0;

        // Nested routes inherit their primary section's position in the stack.
        const firstSegment = normalizedPath.split('/').filter(Boolean)[0];
        if (!firstSegment) return -1;

        const sectionPath = `/${firstSegment}` as (typeof orderedRoomRoutes)[number];
        return orderedRoomRoutes.indexOf(sectionPath);
      };

      const setRoomTransitionDirection = (event: TransitionBeforePreparationEvent) => {
        const fromIndex = getRoomRouteIndex(event.from.pathname);
        const toIndex = getRoomRouteIndex(event.to.pathname);

        if (fromIndex < 0 || toIndex < 0 || fromIndex === toIndex) return;

        // Astro's forward animation lifts the current room and reveals the room
        // below. The back animation is the exact inverse.
        event.direction = toIndex > fromIndex ? 'forward' : 'back';
      };

      const getPdfViewerUrl = (destinationUrl: URL) => {
        const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
        const viewerUrl = new URL(`${basePath}/pdf/`, destinationUrl.origin);
        viewerUrl.searchParams.set(
          'src',
          `${destinationUrl.pathname}${destinationUrl.search}${destinationUrl.hash}`,
        );
        return viewerUrl;
      };

      const rewritePdfLink = (link: HTMLAnchorElement) => {
        if (link.hasAttribute('download')) return false;

        const currentUrl = new URL(window.location.href);
        const destinationUrl = new URL(link.href, currentUrl);

        if (destinationUrl.origin !== currentUrl.origin) return false;
        if (!/\.pdf$/i.test(destinationUrl.pathname)) return false;

        link.href = getPdfViewerUrl(destinationUrl).href;
        return true;
      };

      const rewritePdfLinks = () => {
        document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(rewritePdfLink);
      };

      const routePdfNavigation = (event: MouseEvent) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const link = target.closest<HTMLAnchorElement>('a[href]');
        if (!link) return;

        const targetName = link.target.toLowerCase();
        if (targetName && targetName !== '_self' && targetName !== '_blank') return;

        const wasRewritten = rewritePdfLink(link);
        if (!wasRewritten) return;

        // A normal same-tab PDF click leaves the room-transition system
        // entirely and enters the fullscreen document shell directly.
        if (
          (!targetName || targetName === '_self') &&
          event.button === 0 &&
          !event.metaKey &&
          !event.ctrlKey &&
          !event.shiftKey &&
          !event.altKey
        ) {
          event.preventDefault();
          window.location.assign(link.href);
        }
      };

      const preventRedundantNavigation = (event: MouseEvent) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        const target = event.target;
        if (!(target instanceof Element)) return;

        const link = target.closest<HTMLAnchorElement>('a[href]');
        if (!link || link.hasAttribute('download')) return;
        if (link.target && link.target.toLowerCase() !== '_self') return;

        const currentUrl = new URL(window.location.href);
        const destinationUrl = new URL(link.href, currentUrl);

        if (destinationUrl.origin !== currentUrl.origin) return;

        const isCurrentPage =
          normalizePath(destinationUrl.pathname) === normalizePath(currentUrl.pathname) &&
          destinationUrl.search === currentUrl.search &&
          destinationUrl.hash === currentUrl.hash;

        if (isCurrentPage) event.preventDefault();
      };

      if (elevatorTabAnimationsEnabled) {
        document.addEventListener('astro:before-preparation', setRoomTransitionDirection);
      }
      // Rewrite static links up front so context-menu / new-tab actions also
      // target the site viewer. Repeat after Astro swaps in a new document.
      rewritePdfLinks();
      document.addEventListener('astro:page-load', rewritePdfLinks);
      // Catch dynamically inserted PDF links before their default action.
      document.addEventListener('click', routePdfNavigation, { capture: true });
      // Capture first so Astro's router never starts a transition for a link that
      // points to the exact page already on screen. Modified clicks stay native.
      document.addEventListener('click', preventRedundantNavigation, { capture: true });
    </script>

    <script>
      const startAnalytics = () => {
        void import('@/lib/analytics').then(({ initAnalytics }) => {
          initAnalytics();
        });
      };

      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(startAnalytics, { timeout: 2_000 });
      } else {
        globalThis.setTimeout(startAnalytics, 500);
      }
    </script>
  </body>
</html>
