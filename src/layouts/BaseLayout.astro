---
import BaseHead from '@/components/core/BaseHead.astro';
import Header from '@/components/core/Header.astro';
import SkipLink from '@/components/core/SkipLink.astro';
import ThemeBootstrap from '@/components/core/ThemeBootstrap.astro';
import SharedRoomBackdrop from '@/features/wall/SharedRoomBackdrop.svelte';
import PrimaryRoomEngine from '@/features/room/PrimaryRoomEngine.svelte';
import { ClientRouter } from 'astro:transitions';
import { siteConfig } from '@/config/site';
import { WALL_START_X } from '@/features/wall/wall-config';
import { PROJECT_START_X } from '@/features/wall/project-wall-config';
import { RESUME_START_X } from '@/features/wall/resume-wall-config';
import { withBase } from '@/lib/paths';
import '@/styles/global.css';
// Keep the five primary room styles resident from the first paint. Astro's
// client router otherwise has to wait for route-specific stylesheets during a
// swap, which makes a cached navigation still feel slower than a native tab.
import '@/styles/wall-home.css';
import '@/styles/about.css';
import '@/styles/about-scroll.css';
import '@/styles/projects-wall.css';
import '@/styles/resume.css';
import '@/styles/contact.css';
import '@/styles/room-shell.css';
import '@/styles/wall-backdrop.css';
import '@/styles/floor-scene.css';
import '@/styles/conveyor.css';
import '@/styles/primary-rooms.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  socialTitle?: string;
  socialDescription?: string;
  socialImage?: string;
  socialImageAlt?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
  socialImageType?: string;
  structuredData?: Record<string, unknown> | readonly Record<string, unknown>[];
  mainClass?: string;
  bodyClass?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  imageType,
  socialTitle,
  socialDescription,
  socialImage,
  socialImageAlt,
  socialImageWidth,
  socialImageHeight,
  socialImageType,
  structuredData,
  mainClass,
  bodyClass,
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const normalizedPathname = pathname === '/' ? '/' : pathname.replace(/\/+$/, '');
const isPrimaryRoom =
  normalizedPathname === '/' ||
  normalizedPathname === '/about' ||
  normalizedPathname === '/projects' ||
  normalizedPathname === '/resumes' ||
  normalizedPathname === '/contact';
const roomThemeClass = pathname.startsWith('/about')
  ? 'room-theme-about'
  : pathname.startsWith('/projects')
    ? 'room-theme-projects'
    : pathname.startsWith('/resumes')
      ? 'room-theme-resume'
      : pathname.startsWith('/contact')
        ? 'room-theme-contact'
        : pathname.startsWith('/stats') || pathname.startsWith('/privacy')
          ? 'room-theme-stats'
          : undefined;

const primaryRoomInitialCameraX =
  normalizedPathname === '/projects'
    ? PROJECT_START_X
    : normalizedPathname === '/resumes'
      ? RESUME_START_X
      : normalizedPathname === '/'
        ? WALL_START_X
        : 0;

const primaryRoomAboutProps = {
  portraitUrl: withBase('/images/about/cyrus-portrait-480.webp'),
  softwareResumeUrl: withBase('/resumes/cyrus-asasi-software-engineering-resume.pdf'),
  projectsUrl: withBase('/projects/'),
  musicResumeUrl: withBase('/resumes/cyrus-asasi-clarinet-performance-resume.pdf'),
  musicVideoUrl: 'https://www.youtube.com/watch?v=EkgH4zzXoNg',
  pickleballArticleUrl:
    'https://www.dupr.com/post/california-super-regional-recap-ucla-rises-hawaii-makes-history-and-the-west-coast-delivers',
  chessProfileUrl: 'https://www.chess.com/member/Cyrus2020SD/stats?time=0',
};

const hasSiteRoomBackdrop = !isPrimaryRoom;
const elevatorTabAnimationsEnabled = siteConfig.ui.enableElevatorTabAnimations;
const clientRouterFallback = elevatorTabAnimationsEnabled ? 'animate' : 'swap';

const roomLiftTransition = {
  forwards: {
    old: {
      name: 'room-lift-out',
      duration: '1250ms',
      easing: 'linear',
      fillMode: 'both',
    },
    new: {
      name: 'room-rise-in',
      duration: '1250ms',
      easing: 'linear',
      fillMode: 'both',
    },
  },
  backwards: {
    old: {
      name: 'room-drop-out',
      duration: '1250ms',
      easing: 'linear',
      fillMode: 'both',
    },
    new: {
      name: 'room-descend-in',
      duration: '1250ms',
      easing: 'linear',
      fillMode: 'both',
    },
  },
};
---

<!doctype html>
<html
  lang="en-US"
  data-theme="light"
  data-elevator-tab-animations={elevatorTabAnimationsEnabled ? 'on' : 'off'}
  transition:name="root"
  transition:animate={elevatorTabAnimationsEnabled ? roomLiftTransition : 'none'}
>
  <head>
    <ThemeBootstrap />
    <BaseHead
      {title}
      {description}
      {image}
      {imageAlt}
      {imageWidth}
      {imageHeight}
      {imageType}
      {socialTitle}
      {socialDescription}
      {socialImage}
      {socialImageAlt}
      {socialImageWidth}
      {socialImageHeight}
      {socialImageType}
      {structuredData}
      {noindex}
    />
    <slot name="head" />
    <ClientRouter fallback={clientRouterFallback} />
  </head>

  <body
    class:list={[
      bodyClass,
      isPrimaryRoom && 'primary-room-page',
      roomThemeClass && 'room-themed',
      roomThemeClass,
      hasSiteRoomBackdrop && 'has-site-room-backdrop',
    ]}
  >
    <SharedRoomBackdrop
      client:load
      transition:persist="global-room-backdrop"
      initialCameraX={primaryRoomInitialCameraX}
    />
    {isPrimaryRoom && (
      <PrimaryRoomEngine
        client:load
        transition:persist="primary-room-engine"
        initialPath={pathname}
        {...primaryRoomAboutProps}
      />
    )}
    <SkipLink />
    <Header />

    <main id="main-content" class={mainClass}>
      <slot />
    </main>

    <script>
      import type { TransitionBeforePreparationEvent } from 'astro:transitions/client';

      const elevatorTabAnimationsEnabled =
        document.documentElement.dataset.elevatorTabAnimations === 'on';

      // Primary room order: Home -> About -> Projects -> Resumes -> Contact.
      // Moving right reveals the room below; moving left reveals the room above.
      const orderedRoomRoutes = ['/', '/about', '/projects', '/resumes', '/contact'] as const;

      const normalizePath = (pathname: string) => {
        if (pathname === '/') return '/';
        return pathname.replace(/\/+$/, '');
      };

      const getRoomRouteIndex = (pathname: string) => {
        const normalizedPath = normalizePath(pathname);
        if (normalizedPath === '/') return 0;

        // Nested routes inherit their primary section's position in the stack.
        const firstSegment = normalizedPath.split('/').filter(Boolean)[0];
        if (!firstSegment) return -1;

        const sectionPath = `/${firstSegment}` as (typeof orderedRoomRoutes)[number];
        return orderedRoomRoutes.indexOf(sectionPath);
      };

      const setRoomTransitionDirection = (event: TransitionBeforePreparationEvent) => {
        const fromIndex = getRoomRouteIndex(event.from.pathname);
        const toIndex = getRoomRouteIndex(event.to.pathname);

        if (fromIndex < 0 || toIndex < 0 || fromIndex === toIndex) return;

        // Astro's forward animation lifts the current room and reveals the room
        // below. The back animation is the exact inverse.
        event.direction = toIndex > fromIndex ? 'forward' : 'back';
      };

      const getPdfViewerUrl = (destinationUrl: URL) => {
        const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
        const viewerUrl = new URL(`${basePath}/pdf/`, destinationUrl.origin);
        viewerUrl.searchParams.set(
          'src',
          `${destinationUrl.pathname}${destinationUrl.search}${destinationUrl.hash}`,
        );
        return viewerUrl;
      };

      const rewritePdfLink = (link: HTMLAnchorElement) => {
        if (link.hasAttribute('download')) return false;

        const currentUrl = new URL(window.location.href);
        const destinationUrl = new URL(link.href, currentUrl);

        if (destinationUrl.origin !== currentUrl.origin) return false;
        if (!/\.pdf$/i.test(destinationUrl.pathname)) return false;

        link.href = getPdfViewerUrl(destinationUrl).href;
        return true;
      };

      const rewritePdfLinks = () => {
        document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(rewritePdfLink);
      };

      const setPersistentHeaderCurrentPath = (pathname: string) => {
        const currentPath = normalizePath(pathname);
        document
          .querySelectorAll<HTMLAnchorElement>('.primary-nav a[data-nav-path]')
          .forEach((link) => {
            const navPath = normalizePath(link.dataset.navPath || new URL(link.href).pathname);
            if (navPath === currentPath) link.setAttribute('aria-current', 'page');
            else link.removeAttribute('aria-current');
          });
      };

      const updatePersistentHeaderCurrentState = () => {
        setPersistentHeaderCurrentPath(window.location.pathname);
      };

      const warmAboutFromNavigationIntent = (event: Event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const link = target.closest<HTMLAnchorElement>('.primary-nav a[data-nav-path]');
        if (!link) return;

        const destination = new URL(link.href, window.location.href);
        if (destination.origin !== window.location.origin) return;
        if (normalizePath(destination.pathname) !== '/about') return;

        document.dispatchEvent(new CustomEvent('hecate:warm-about'));
      };

      const reflectPrimaryNavigationIntent = (event: MouseEvent) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest<HTMLAnchorElement>('.primary-nav a[data-nav-path]');
        if (!link) return;

        const destination = new URL(link.href, window.location.href);
        if (destination.origin !== window.location.origin) return;
        setPersistentHeaderCurrentPath(destination.pathname);
      };

      const routePdfNavigation = (event: MouseEvent) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const link = target.closest<HTMLAnchorElement>('a[href]');
        if (!link) return;

        const targetName = link.target.toLowerCase();
        if (targetName && targetName !== '_self' && targetName !== '_blank') return;

        const wasRewritten = rewritePdfLink(link);
        if (!wasRewritten) return;

        // A normal same-tab PDF click leaves the room-transition system
        // entirely and enters the fullscreen document shell directly.
        if (
          (!targetName || targetName === '_self') &&
          event.button === 0 &&
          !event.metaKey &&
          !event.ctrlKey &&
          !event.shiftKey &&
          !event.altKey
        ) {
          event.preventDefault();
          window.location.assign(link.href);
        }
      };

      const preventRedundantNavigation = (event: MouseEvent) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        const target = event.target;
        if (!(target instanceof Element)) return;

        const link = target.closest<HTMLAnchorElement>('a[href]');
        if (!link || link.hasAttribute('download')) return;
        if (link.target && link.target.toLowerCase() !== '_self') return;

        const currentUrl = new URL(window.location.href);
        const destinationUrl = new URL(link.href, currentUrl);

        if (destinationUrl.origin !== currentUrl.origin) return;

        const isCurrentPage =
          normalizePath(destinationUrl.pathname) === normalizePath(currentUrl.pathname) &&
          destinationUrl.search === currentUrl.search &&
          destinationUrl.hash === currentUrl.hash;

        if (isCurrentPage) event.preventDefault();
      };

      type NavigationWindow = Window & { __hecateNavigationHandlersInstalled?: boolean };
      const navigationWindow = window as NavigationWindow;

      // Astro's router keeps the same document alive across page swaps. Install
      // these document-level handlers once so repeated navigation can never
      // accumulate duplicate click/page-load work.
      if (!navigationWindow.__hecateNavigationHandlersInstalled) {
        navigationWindow.__hecateNavigationHandlersInstalled = true;

        if (elevatorTabAnimationsEnabled) {
          document.addEventListener('astro:before-preparation', setRoomTransitionDirection);
        }
        document.addEventListener('astro:page-load', rewritePdfLinks);
        document.addEventListener('astro:page-load', updatePersistentHeaderCurrentState);
        document.addEventListener('pointerover', warmAboutFromNavigationIntent, { capture: true });
        document.addEventListener('focusin', warmAboutFromNavigationIntent, { capture: true });
        document.addEventListener('pointerdown', warmAboutFromNavigationIntent, { capture: true });
        document.addEventListener('click', reflectPrimaryNavigationIntent, { capture: true });
        document.addEventListener('click', routePdfNavigation, { capture: true });
        document.addEventListener('click', preventRedundantNavigation, { capture: true });
      }

      // Handle the initial document immediately. Subsequent swaps are covered
      // by the single astro:page-load listener above.
      rewritePdfLinks();
      updatePersistentHeaderCurrentState();
    </script>

    <script>
      type PerformanceBootstrapWindow = Window & {
        __hecatePrimaryRoomsWarmed?: boolean;
        __hecateAnalyticsBootstrapScheduled?: boolean;
      };
      const performanceWindow = window as PerformanceBootstrapWindow;

      const scheduleIdle = (callback: () => void, timeout: number, fallbackDelay: number) => {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(callback, { timeout });
        } else {
          globalThis.setTimeout(callback, fallbackDelay);
        }
      };

      // HTML/CSS for the five navbar rooms is prepared by Astro's eager
      // prefetch path. Warm the two interactive runtime families as
      // well so a fallback browser does not discover their JS only after the
      // user clicks. Dynamic imports keep them off the critical first-paint
      // path while still putting their chunks in the module cache.
      const warmPrimaryRooms = () => {
        if (performanceWindow.__hecatePrimaryRoomsWarmed) return;
        performanceWindow.__hecatePrimaryRoomsWarmed = true;

        scheduleIdle(
          () => {
            void Promise.allSettled([
              import('@/features/room/PrimaryRoomEngine.svelte'),
              import('@/features/wall/ProjectWall.svelte'),
              import('@/components/about/AboutTV.svelte'),
            ]);

            // The remaining primary-room imagery is small after the responsive
            // image pass. Put the exact candidates the device is likely to use
            // into the browser image cache before a navbar click so an already
            // prepared room never arrives with a blank painting/portrait.
            const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
            const useRetinaCandidates = (window.devicePixelRatio || 1) >= 1.5;
            const primaryRoomImages = useRetinaCandidates
              ? [
                  '/images/about/cyrus-portrait-480.webp',
                  '/paintings/the-stare.webp',
                  '/paintings/pastry-chef.webp',
                  '/paintings/stats-portrait-720.webp',
                  '/paintings/madame-le-peletier.webp',
                  '/images/project-gallery/neutra.webp',
                  '/images/project-gallery/sunset-720.webp',
                  '/images/project-gallery/keycad.webp',
                  '/images/project-gallery/portfolio.webp',
                  '/images/resume/cyrus-asasi-software-engineering-resume-720.webp',
                  '/images/resume/cyrus-asasi-clarinet-performance-resume-720.webp',
                  '/images/contact/chalkboard-photo.webp',
                ]
              : [
                  '/images/about/cyrus-portrait-480.webp',
                  '/paintings/the-stare-480.webp',
                  '/paintings/pastry-chef-480.webp',
                  '/paintings/stats-portrait-480.webp',
                  '/paintings/madame-le-peletier-480.webp',
                  '/images/project-gallery/neutra-480.webp',
                  '/images/project-gallery/sunset-480.webp',
                  '/images/project-gallery/keycad-480.webp',
                  '/images/project-gallery/portfolio-480.webp',
                  '/images/resume/cyrus-asasi-software-engineering-resume-480.webp',
                  '/images/resume/cyrus-asasi-clarinet-performance-resume-480.webp',
                  '/images/contact/chalkboard-photo.webp',
                ];

            for (const source of primaryRoomImages) {
              const image = new Image();
              image.decoding = 'async';
              image.fetchPriority = 'low';
              image.src = `${basePath}${source}`;
            }
          },
          1_250,
          300,
        );
      };

      warmPrimaryRooms();

      const scheduleAnalytics = () => {
        if (performanceWindow.__hecateAnalyticsBootstrapScheduled) return;
        performanceWindow.__hecateAnalyticsBootstrapScheduled = true;

        scheduleIdle(
          () => {
            void import('@/lib/analytics').then(({ initAnalytics }) => {
              initAnalytics();
            });
          },
          2_000,
          500,
        );
      };

      scheduleAnalytics();
    </script>
  </body>
</html>
