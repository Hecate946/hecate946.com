---
import HtmlSiteTree from '@/components/core/HtmlSiteTree.astro';
import BaseHead from '@/components/core/BaseHead.astro';
import Footer from '@/components/core/Footer.astro';
import Header from '@/components/core/Header.astro';
import SkipLink from '@/components/core/SkipLink.astro';
import ThemeBootstrap from '@/components/core/ThemeBootstrap.astro';
import SeasonalShower from '@/components/islands/SeasonalShower.svelte';
import CommandPalette from '@/components/islands/CommandPalette.svelte';
import { headerNavigation } from '@/config/navigation';
import { shouldShowSeasonalShower } from '@/config/seasonal-shower';
import { navigation } from '@/config/site';
import { withBase } from '@/lib/paths';
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  hideFooter?: boolean;
  suppressSeasonalShower?: boolean;
  mainClass?: string;
  bodyClass?: string;
  soundSilent?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  hideFooter = false,
  suppressSeasonalShower = false,
  mainClass,
  bodyClass,
  soundSilent = false,
  noindex = false,
} = Astro.props;

const normalizePath = (value: string) => {
  const normalized = value.replace(/\/+$/, '');
  return normalized === '' ? '/' : normalized;
};

const currentPath = normalizePath(Astro.url.pathname);
const showSeasonalShower =
  !suppressSeasonalShower && shouldShowSeasonalShower(Astro.url.pathname);

const htmlPage = currentPath === '/' ? 'home' : 'interior';

const commandItems = Array.from(
  new Map(
    [...headerNavigation, ...navigation].map((item) => [
      item.href,
      {
        label: item.label,
        href: withBase(item.href),
      },
    ]),
  ).values(),
);

---

<!doctype html>
<html
  lang="en"
  transition:animate="none"
  data-season="summer"
  data-season-preference="auto"
  data-theme="light"
  data-html-mode="false"
>
  <head>
    <ThemeBootstrap />
    <BaseHead {title} {description} {image} {noindex} />
    <slot name="head" />
    <ClientRouter fallback="swap" />
  </head>

  <body
    data-html-page={htmlPage}
    class={bodyClass}
    data-site-sound-silent={soundSilent ? true : undefined}
  >
    <HtmlSiteTree currentPath={Astro.url.pathname} />
    <SkipLink />

    {
      showSeasonalShower && (
        <SeasonalShower
          client:idle
          transition:persist="seasonal-shower"
        />
      )
    }

    <Header />

    <main
      id="main-content"
      class={mainClass}
      data-default-only={htmlPage === 'home' ? true : undefined}
    >
      <slot />
    </main>


    {!hideFooter && <Footer />}
    <CommandPalette client:idle items={commandItems} />


    <script>
      import { initializeHtmlMode } from '@/lib/html-mode';
      import { initializeSiteSound } from '@/lib/site-sound';

      const GRAPH_RETURN_STORAGE_KEY = 'hecate946:graph-return';

      const rememberLastNonGraphLocation = () => {
        const normalizedPath = window.location.pathname.replace(/\/+$/, '') || '/';
        if (normalizedPath.endsWith('/graph')) return;

        try {
          sessionStorage.setItem(
            GRAPH_RETURN_STORAGE_KEY,
            `${window.location.pathname}${window.location.search}${window.location.hash}`,
          );
        } catch {
          // Navigation still works with the graph's home fallback if storage is unavailable.
        }
      };

      const initializePersistentControls = () => {
        initializeHtmlMode();
        initializeSiteSound();
        rememberLastNonGraphLocation();
      };

      initializePersistentControls();

      document.addEventListener('astro:page-load', initializePersistentControls);

      const startAnalytics = () => {
        void import('@/lib/analytics').then(({ initAnalytics }) => {
          initAnalytics();
        });
      };

      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(startAnalytics, { timeout: 2_000 });
      } else {
        globalThis.setTimeout(startAnalytics, 500);
      }
    </script>
  </body>
</html>