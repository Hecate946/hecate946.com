---
import BaseHead from '@/components/core/BaseHead.astro';
import Header from '@/components/core/Header.astro';
import SkipLink from '@/components/core/SkipLink.astro';
import ThemeBootstrap from '@/components/core/ThemeBootstrap.astro';
import SharedRoomBackdrop from '@/features/wall/SharedRoomBackdrop.astro';
import PrimaryRoomEngine from '@/features/room/PrimaryRoomEngine.svelte';
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
// Keep the primary room styles resident from the first paint. Astro's client
// router otherwise has to wait for route-specific stylesheets during a swap,
// which makes a cached navigation still feel slower than a native tab.
import '@/styles/wall-home.css';
import '@/styles/page-scroll.css';
import '@/styles/about-scroll.css';
import '@/styles/projects-wall.css';
import '@/styles/resume.css';
import '@/styles/generated-resume.css';
import '@/styles/contact.css';
import '@/styles/room-shell.css';
import '@/styles/wall-backdrop.css';
import '@/styles/floor-scene.css';
import '@/styles/conveyor.css';
import '@/styles/primary-rooms.css';

interface Props {
  title?: string;
  description?: string;
  socialTitle?: string;
  socialDescription?: string;
  socialImage?: string;
  socialImageAlt?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
  mainEntityId?: string;
  breadcrumbId?: string;
  structuredData?: Record<string, unknown> | readonly Record<string, unknown>[];
  mainClass?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  socialTitle,
  socialDescription,
  socialImage,
  socialImageAlt,
  socialImageWidth,
  socialImageHeight,
  mainEntityId,
  breadcrumbId,
  structuredData,
  mainClass,
  bodyClass,
} = Astro.props;

const pathname = Astro.url.pathname;
const normalizedPathname =
  pathname === '/' ? '/' : pathname.replace(/\/+$/, '');
const isPrimaryRoom =
  normalizedPathname === '/' ||
  normalizedPathname === '/about' ||
  normalizedPathname === '/projects' ||
  normalizedPathname === '/resumes' ||
  normalizedPathname === '/contact';
const isScrollingPrimaryRoom =
  normalizedPathname === '/about' ||
  normalizedPathname === '/projects' ||
  normalizedPathname === '/resumes' ||
  normalizedPathname === '/contact';
const roomThemeClass = pathname.startsWith('/about')
  ? 'room-theme-about'
  : pathname.startsWith('/projects')
    ? 'room-theme-projects'
    : pathname.startsWith('/resumes')
      ? 'room-theme-resume'
      : pathname.startsWith('/contact')
        ? 'room-theme-contact'
        : undefined;

// Every primary room starts from the same world coordinate. Home previously
// republished a viewport-dependent camera after hydration, which shifted the
// bricks and checkerboard on reload and made them disagree with About.
const primaryRoomInitialCameraX = 0;

const hasSiteRoomBackdrop = !isPrimaryRoom;
---

<!doctype html>
<html lang="en-US" data-theme="light" transition:animate="none">
  <head>
    <ThemeBootstrap />
    <BaseHead
      {title}
      {description}
      {socialTitle}
      {socialDescription}
      {socialImage}
      {socialImageAlt}
      {socialImageWidth}
      {socialImageHeight}
      {mainEntityId}
      {breadcrumbId}
      {structuredData}
    />
    <slot name="head" />
    <ClientRouter fallback="swap" />
  </head>

  <body
    class:list={[
      bodyClass,
      isPrimaryRoom && 'primary-room-page',
      isScrollingPrimaryRoom && 'scrolling-primary-room',
      roomThemeClass && 'room-themed',
      roomThemeClass,
      hasSiteRoomBackdrop && 'has-site-room-backdrop',
    ]}
  >
    <SharedRoomBackdrop initialCameraX={primaryRoomInitialCameraX} />
    {
      isPrimaryRoom && (
        <PrimaryRoomEngine
          client:load
          transition:persist="primary-room-engine"
          initialPath={pathname}
        />
      )
    }
    <SkipLink />
    <Header />

    <main id="main-content" class={mainClass}>
      <slot />
    </main>
  </body>
</html>
