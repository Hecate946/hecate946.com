---
import BaseHead from '@/components/core/BaseHead.astro';
import Header from '@/components/core/Header.astro';
import SkipLink from '@/components/core/SkipLink.astro';
import ThemeBootstrap from '@/components/core/ThemeBootstrap.astro';
import WallRoom from '@/features/wall/WallRoom.svelte';
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  mainClass?: string;
  bodyClass?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  imageType,
  mainClass,
  bodyClass,
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const isDedicatedRoom = pathname === '/' || pathname === '/about/' || pathname === '/about';
const roomThemeClass = pathname.startsWith('/projects')
  ? 'room-theme-projects'
  : pathname.startsWith('/resume')
    ? 'room-theme-resume'
    : pathname.startsWith('/contact')
      ? 'room-theme-contact'
      : pathname.startsWith('/stats')
        ? 'room-theme-stats'
        : undefined;
---

<!doctype html>
<html
  lang="en-US"
  transition:animate="none"
  data-theme="light"
>
  <head>
    <ThemeBootstrap />
    <BaseHead {title} {description} {image} {imageAlt} {imageWidth} {imageHeight} {imageType} {noindex} />
    <slot name="head" />
    <ClientRouter fallback="swap" />
  </head>

  <body class:list={[bodyClass, roomThemeClass]}>
    {!isDedicatedRoom && (
      <div class="site-room-backdrop wall-room-host" aria-hidden="true">
        <WallRoom />
      </div>
    )}
    <SkipLink />
    <Header />

    <main id="main-content" class={mainClass}>
      <slot />
    </main>


    <script>
      const startAnalytics = () => {
        void import('@/lib/analytics').then(({ initAnalytics }) => {
          initAnalytics();
        });
      };

      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(startAnalytics, { timeout: 2_000 });
      } else {
        globalThis.setTimeout(startAnalytics, 500);
      }
    </script>
  </body>
</html>
