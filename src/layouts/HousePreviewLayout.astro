---
import HtmlSiteTree from '@/components/core/HtmlSiteTree.astro';
import BaseHead from '@/components/core/BaseHead.astro';
import ThemeBootstrap from '@/components/core/ThemeBootstrap.astro';
import { withBase } from '@/lib/paths';
import '@/styles/house-preview.css';
import '@/styles/html-mode.css';

interface Props {
  active: 'png' | 'svg' | 'compare';
  title: string;
  description: string;
}

const { active, title, description } = Astro.props;
const pngHref = withBase('/house-png/');
const svgHref = withBase('/house-svg/');
const compareHref = withBase('/house-compare/');
const homeHref = withBase('/');
const currentPath = Astro.url.pathname;
const plainTitle = title.split('—')[0].trim();
---

<!doctype html>
<html lang="en" data-html-mode="false" data-theme="light">
  <head>
    <ThemeBootstrap />
    <BaseHead {title} {description} />
    <meta name="robots" content="noindex" />
  </head>
  <body class:list={['house-preview-page', `house-preview-page--${active}`]} data-html-page="interior">
    <HtmlSiteTree {currentPath} />

    <div data-default-only>
      <nav class="house-preview-nav" aria-label="House preview formats">
        <div class="house-preview-nav__formats">
          <a class:list={['house-preview-nav__link', active === 'png' && 'is-active']} href={pngHref} aria-current={active === 'png' ? 'page' : undefined} data-house-format="png">PNG</a>
          <a class:list={['house-preview-nav__link', active === 'svg' && 'is-active']} href={svgHref} aria-current={active === 'svg' ? 'page' : undefined} data-house-format="svg">SVG</a>
          <a class:list={['house-preview-nav__link', active === 'compare' && 'is-active']} href={compareHref} aria-current={active === 'compare' ? 'page' : undefined} data-house-format="compare">Compare</a>
        </div>
        <span class="house-preview-nav__keys" aria-hidden="true">P / V / C</span>
        <a class="house-preview-nav__home" href={homeHref}>Home</a>
      </nav>

      <main class="house-preview-stage">
        <slot />
      </main>
    </div>

    <section data-html-only>
      <h1>{plainTitle}</h1>
      <p>{description}</p>
    </section>

    <script>
      import { initializeHtmlMode } from '@/lib/html-mode';
      initializeHtmlMode();
    </script>

    <script is:inline>
      document.addEventListener('keydown', (event) => {
        if (document.documentElement.dataset.htmlMode === 'true') return;
        if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) return;
        if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) return;

        const key = event.key.toLowerCase();
        if (key !== 'p' && key !== 'v' && key !== 'c') return;

        const format = key === 'p' ? 'png' : key === 'v' ? 'svg' : 'compare';
        const link = document.querySelector(`[data-house-format="${format}"]`);
        if (link instanceof HTMLAnchorElement) link.click();
      });
    </script>
  </body>
</html>
