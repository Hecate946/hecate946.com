---
import BaseHead from '@/components/core/BaseHead.astro';
import ThemeBootstrap from '@/components/core/ThemeBootstrap.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html
  lang="en"
  data-season="summer"
  data-season-preference="auto"
  data-theme="light"
>
  <head>
    <ThemeBootstrap />
    <BaseHead {title} {description} {image} />
  </head>

  <body class="immersive-page">
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  html,
  body.immersive-page {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #020202;
  }

  body.immersive-page #main-content {
    width: 100%;
    height: 100%;
    min-height: 100%;
    margin: 0;
    padding: 0;
  }
</style>
