---
import HtmlSiteTree from '@/components/core/HtmlSiteTree.astro';
import BaseHead from '@/components/core/BaseHead.astro';
import ThemeBootstrap from '@/components/core/ThemeBootstrap.astro';
import '@/styles/global.css';
import '@/styles/html-mode.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const currentPath = Astro.url.pathname;
const plainTitle = title?.split('|')[0].trim() || 'Immersive page';
---

<!doctype html>
<html
  lang="en"
  data-season="summer"
  data-season-preference="auto"
  data-theme="light"
  data-html-mode="false"
>
  <head>
    <ThemeBootstrap />
    <BaseHead {title} {description} {image} />
  </head>

  <body class="immersive-page" data-html-page="interior">
    <HtmlSiteTree {currentPath} />

    <main id="main-content">
      <div data-html-only>
        <h1>{plainTitle}</h1>
        {description && <p>{description}</p>}
      </div>
      <div data-default-only>
        <slot />
      </div>
    </main>

    <script>
      import { initializeHtmlMode } from '@/lib/html-mode';
      initializeHtmlMode();
    </script>
  </body>
</html>

<style is:global>
  html:not([data-html-mode='true']),
  html:not([data-html-mode='true']) body.immersive-page {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #020202;
  }

  html:not([data-html-mode='true']) body.immersive-page #main-content,
  html:not([data-html-mode='true']) body.immersive-page [data-default-only] {
    width: 100%;
    height: 100%;
    min-height: 100%;
    margin: 0;
    padding: 0;
  }
</style>
