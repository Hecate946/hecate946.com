---
import BaseHead from '@/components/core/BaseHead.astro';
import ThemeBootstrap from '@/components/core/ThemeBootstrap.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const plainTitle = title?.split('|')[0].trim() || 'Immersive page';
---

<!doctype html>
<html
  lang="en-US"
  data-season="summer"
  data-season-preference="auto"
  data-theme="light"
  data-html-mode="false"
>
  <head>
    <ThemeBootstrap />
    <BaseHead {title} {description} {image} />
  </head>

  <body class="immersive-page">
    <main id="main-content">
      <header class="visually-hidden">
        <h1>{plainTitle}</h1>
        {description && <p>{description}</p>}
      </header>
      <slot />
    </main>

    <script>
      import { initializeHtmlMode } from '@/lib/html-mode';
      initializeHtmlMode();
    </script>
  </body>
</html>

<style is:global>
  html,
  body.immersive-page {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #020202;
  }

  body.immersive-page #main-content {
    width: 100%;
    height: 100%;
    min-height: 100%;
    margin: 0;
    padding: 0;
  }
</style>
