---
import { withBase } from '@/lib/paths';

const destination = withBase('/resumes/');
const canonical = new URL(destination, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <meta
      name="description"
      content="This legacy resume URL redirects to Cyrus Asasi’s current resumes page."
    />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={canonical} />
    <title>Resumes — Cyrus Asasi</title>
  </head>
  <body>
    <p>
      This page moved to <a href={destination}>Resumes</a>.
    </p>
  </body>
</html>
