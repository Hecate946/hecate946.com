---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ResumeGallery from '@/components/resume/ResumeGallery.svelte';
import { withBase } from '@/lib/paths';
import '@/styles/resume.css';

const softwareResumeUrl = withBase('/resumes/cyrus-asasi-software-engineering-resume.pdf');
const musicResumeUrl = withBase('/resumes/cyrus-asasi-clarinet-performance-resume.pdf');

const resumes = [
  {
    id: 'software',
    number: '01',
    label: 'Software Engineering',
    shortLabel: 'Software Engineering',
    pdfUrl: softwareResumeUrl,
    previewUrl: withBase('/images/resume/software-2160.webp'),
    previewSrcset: `${withBase('/images/resume/software-1440.webp')} 1440w, ${withBase('/images/resume/software-2160.webp')} 2160w`,
    previewWidth: 2160,
    previewHeight: 3055,
  },
  {
    id: 'clarinet',
    number: '02',
    label: 'Clarinet Performance',
    shortLabel: 'Clarinet Performance',
    pdfUrl: musicResumeUrl,
    previewUrl: withBase('/images/resume/clarinet-2160.webp'),
    previewSrcset: `${withBase('/images/resume/clarinet-1440.webp')} 1440w, ${withBase('/images/resume/clarinet-2160.webp')} 2160w`,
    previewWidth: 2160,
    previewHeight: 3055,
  },
] as const;
---

<BaseLayout
  title="Resume — Cyrus Asasi"
  description="Software engineering and clarinet performance resumes for Cyrus Asasi."
>
  <section class="resume-page interior-page interior-page--eight" aria-labelledby="resume-title">
    <header class="resume-heading interior-page-heading">
      <h1 id="resume-title">Resume</h1>
    </header>

    <div class="resume-content interior-page-content">
      <ResumeGallery {resumes} />
    </div>
  </section>
</BaseLayout>
