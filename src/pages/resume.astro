---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/paths';
import '@/styles/resume.css';

const resumes = [
  {
    title: 'Software Engineering Resume',
    description: 'Education, work experience, and technical skills.',
    href: withBase('/resumes/cyrus-asasi-software-engineering-resume.pdf'),
    downloadName: 'Cyrus-Asasi-Software-Engineering-Resume.pdf',
  },
  {
    title: 'Clarinet Performance Resume',
    description: 'Education, performance experience, and awards.',
    href: withBase('/resumes/cyrus-asasi-clarinet-performance-resume.pdf'),
    downloadName: 'Cyrus-Asasi-Clarinet-Performance-Resume.pdf',
  },
] as const;
---

<BaseLayout
  title="Resume"
  description="Software engineering and music resumes for Cyrus Asasi."
>
  <section class="resume-page interior-page interior-page--six" aria-labelledby="resume-title">
    <header class="resume-heading interior-page-heading">
      <h1 id="resume-title">Resume</h1>
    </header>

    <ul class="resume-list interior-page-content">
      {
        resumes.map((resume) => (
          <li class="resume-list__item">
            <article class="resume-entry">
              <div class="resume-copy">
                <h2>{resume.title}</h2>
                <p>{resume.description}</p>
              </div>

              <ul class="resume-actions" aria-label={`${resume.title} actions`}>
                <li>
                  <a href={resume.href} target="_blank" rel="noopener noreferrer">
                    View PDF
                  </a>
                </li>
                <li>
                  <a href={resume.href} download={resume.downloadName}>
                    Download
                  </a>
                </li>
              </ul>
            </article>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
