---
import WebsiteGraph from '@/components/islands/WebsiteGraph.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildSiteMapGraph, normalizeSitePath } from '@/lib/site-map';
import { siteRoutes } from '@/lib/site-routes';
import { withBase } from '@/lib/paths';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = normalizeSitePath(
  basePath && Astro.url.pathname.startsWith(basePath)
    ? Astro.url.pathname.slice(basePath.length) || '/'
    : Astro.url.pathname,
);

const graph = buildSiteMapGraph({
  routes: siteRoutes,
  currentPath,
  resolveHref: withBase,
});
---

<BaseLayout
  title="Website Graph — Cyrus Asasi"
  description="An interactive graph of every destination on hecate946.com."
  hideFooter={true}
  suppressSeasonalShower={true}
  mainClass="website-graph-main"
  bodyClass="website-graph-body"
  soundSilent={true}
>
  <header class="visually-hidden">
    <h1>Website Graph</h1>
    <p>An interactive graph of every destination on hecate946.com.</p>
  </header>

  <div class="website-graph-page">
    <WebsiteGraph
      client:load
      nodes={graph.nodes}
      links={graph.links}
      closeHref={withBase('/')}
    />
  </div>

</BaseLayout>

<style is:global>
  html,
  body.website-graph-body {
    width: 100%;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    background: #fff;
    overscroll-behavior: none;
  }

  html[data-theme='dark'],
  html[data-theme='dark'] body.website-graph-body {
    background: #000;
  }

  body.website-graph-body .site-header {
    display: none !important;
  }

  #main-content.website-graph-main {
    box-sizing: border-box;
    width: 100%;
    height: 100dvh;
    min-height: 0;
    padding: 0 !important;
    margin: 0;
    overflow: hidden;
  }

  .website-graph-page,
  .website-graph-page > astro-island {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: #fff;
  }

  html[data-theme='dark'] .website-graph-page,
  html[data-theme='dark'] .website-graph-page > astro-island {
    background: #000;
  }

  .website-graph-html {
    padding: 2rem var(--site-edge);
  }

</style>
