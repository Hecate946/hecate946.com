---
import WebsiteGraph from '@/components/islands/WebsiteGraph.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildSiteMapGraph, normalizeSitePath } from '@/lib/site-map';
import { siteRoutes } from '@/lib/site-routes';
import { withBase } from '@/lib/paths';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = normalizeSitePath(
  basePath && Astro.url.pathname.startsWith(basePath)
    ? Astro.url.pathname.slice(basePath.length) || '/'
    : Astro.url.pathname,
);

const graph = buildSiteMapGraph({
  routes: siteRoutes,
  currentPath,
  resolveHref: withBase,
});
---

<BaseLayout
  title="Website Graph — Cyrus Asasi"
  description="An interactive graph of every destination on hecate946.com."
  hideFooter={true}
  suppressSeasonalShower={true}
  mainClass="website-graph-main"
  bodyClass="website-graph-body"
  soundSilent={true}
>
  <div class="website-graph-page" data-default-only>
    <WebsiteGraph
      client:load
      nodes={graph.nodes}
      links={graph.links}
      closeHref={withBase('/')}
    />
  </div>

  <section class="website-graph-html" data-html-only hidden>
    <h1>Website Graph</h1>
    <p>The graphical view is replaced by the complete route inventory in HTML mode.</p>
    <table>
      <thead>
        <tr>
          <th scope="col">Path</th>
          <th scope="col">Page</th>
          <th scope="col">Description</th>
        </tr>
      </thead>
      <tbody>
        {siteRoutes.map((route) => (
          <tr>
            <td><code>{route.href}</code></td>
            <td><a href={withBase(route.href)}>{route.label}</a></td>
            <td>{route.description ?? ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</BaseLayout>

<style is:global>
  html,
  body.website-graph-body {
    width: 100%;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    background: #fff;
    overscroll-behavior: none;
  }

  html[data-theme='dark'],
  html[data-theme='dark'] body.website-graph-body {
    background: #000;
  }

  body.website-graph-body .site-header {
    display: none !important;
  }

  #main-content.website-graph-main {
    box-sizing: border-box;
    width: 100%;
    height: 100dvh;
    min-height: 0;
    padding: 0 !important;
    margin: 0;
    overflow: hidden;
  }

  .website-graph-page,
  .website-graph-page > astro-island {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: #fff;
  }

  html[data-theme='dark'] .website-graph-page,
  html[data-theme='dark'] .website-graph-page > astro-island {
    background: #000;
  }

  .website-graph-html {
    padding: 2rem var(--site-edge);
  }

</style>
