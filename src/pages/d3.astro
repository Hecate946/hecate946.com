---
import D3Playground from '@/components/islands/D3Playground.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/d3.css';
---

<BaseLayout
  title="D3 Laboratory — Cyrus Asasi"
  description="An interactive gallery of force graphs, layout morphs, gravity fields, graph traversal, collision systems, and generative D3 animations."
>
  <section class="d3-page" aria-labelledby="d3-title">
    <header class="d3-page__heading">
      <p>D3 Laboratory</p>
      <h1 id="d3-title">Graphs that behave like worlds.</h1>
      <p>
        Eight experiments built from one force engine: explore the network, bend its physics, paint gravity,
        trace signals, and watch the same data become completely different systems.
      </p>
    </header>

    <div class="d3-page__content" data-default-only>
      <D3Playground client:visible />
    </div>

    <section data-html-only hidden>
      <h2>Interactive experiments</h2>
      <p>
        The force-graph experiments require the graphical site. Their page,
        title, description, and route remain available here as plain HTML.
      </p>
    </section>
  </section>
</BaseLayout>
