---
import ImmersiveLayout from '@/layouts/ImmersiveLayout.astro';
import PanoramaViewer from '@/features/immersive/PanoramaViewer.svelte';
import { implementedHalls, type ImmersiveSpace } from '@/features/immersive/catalog';

export function getStaticPaths() {
  return implementedHalls.map((space) => ({
    params: { slug: space.slug },
    props: { space },
  }));
}

interface Props {
  space: ImmersiveSpace;
}

const { space } = Astro.props;
---

<ImmersiveLayout title={`${space.title} | Cyrus Asasi`} description={space.description}>
  <section class="panorama-page">
    <PanoramaViewer client:only="svelte" {space} />
  </section>
</ImmersiveLayout>

<style>
  .panorama-page {
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }
</style>
