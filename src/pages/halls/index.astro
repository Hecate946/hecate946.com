---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { hallCatalog } from '@/features/immersive/catalog';
import { withBase } from '@/lib/paths';
---

<BaseLayout title="Halls | Cyrus Asasi" description="Immersive panoramic halls within the house.">
  <section class="space-index">
    <header>
      <p>Ground floor</p>
      <h1>Halls</h1>
    </header>

    <ul class="hall-grid" role="list">
      {
        hallCatalog.map((hall) => (
          <li
            class:list={['hall-card', { planned: !hall.implemented }]}
            style={`--space-color: ${hall.accent}`}
          >
            {hall.implemented ? (
              <a class="hall-card__link" href={withBase(`/halls/${hall.slug}/`)}>
                <span>{hall.label}</span>
                <strong>{hall.title}</strong>
                <small>Enter hall</small>
              </a>
            ) : (
              <article class="hall-card__content">
                <span>{hall.label}</span>
                <strong>{hall.title}</strong>
                <small>In development</small>
              </article>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .space-index {
    width: min(72rem, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: clamp(3rem, 8vw, 8rem);
  }

  header p,
  header h1 {
    margin: 0;
  }

  header p,
  span,
  small {
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  header p {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
  }

  header h1 {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 7rem);
    font-weight: 400;
    line-height: 0.95;
  }

  .hall-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    padding: 0;
    margin: clamp(2rem, 5vw, 4rem) 0 0;
    list-style: none;
  }

  .hall-card {
    position: relative;
    min-width: 0;
    min-height: 18rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--space-color), black 18%);
    border: 1px solid color-mix(in srgb, var(--space-color), white 26%);
    color: #fff;
    contain: paint;
    isolation: isolate;
  }

  .hall-card__link,
  .hall-card__content {
    position: relative;
    inset: auto;
    display: flex;
    width: 100%;
    height: 100%;
    min-height: inherit;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
    color: #fff;
  }

  .hall-card__link {
    text-decoration: none;
    transition: filter 180ms ease, transform 180ms ease;
  }

  .hall-card__link:hover,
  .hall-card__link:focus-visible {
    color: #fff;
    filter: brightness(1.15);
    transform: translateY(-0.25rem);
  }

  .hall-card__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -0.3rem;
  }

  .planned {
    filter: saturate(0.35);
    opacity: 0.72;
  }

  span {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
  }

  strong {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 400;
  }

  small {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
  }

  @media (max-width: 700px) {
    .hall-grid {
      grid-template-columns: 1fr;
    }

    .hall-card {
      min-height: 12rem;
    }
  }
</style>
