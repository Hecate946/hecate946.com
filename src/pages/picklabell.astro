---
import PickleballRoom from '@/components/house/rooms/PickleballRoom.svelte';
import FullScreenPageLayout from '@/layouts/FullScreenPageLayout.astro';
import { withBase } from '@/lib/paths';
import '@/styles/house-room-pages.css';

const homeHref = withBase('/');
---

<FullScreenPageLayout
  title="Picklabell Court — Cyrus Asasi"
  description="A full-screen top-down purple pickleball court."
>
  <main class="house-room-page">
    <a class="house-room-back" href={homeHref}>Back to house</a>
    <div class="house-room-stage">
      <PickleballRoom />
    </div>
  </main>
</FullScreenPageLayout>
