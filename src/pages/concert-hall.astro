---
import BaseHead from '@/components/core/BaseHead.astro';
import ConcertHallRoom from '@/components/house/rooms/ConcertHallRoom.svelte';
import { withBase } from '@/lib/paths';
import '@/styles/house-room-pages.css';

const homeHref = withBase('/');
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Concert Hall — Cyrus Asasi"
      description="A nine-foot concert grand on a full-screen stage framed by red velvet curtains."
    />
  </head>
  <body>
    <main class="house-room-page">
      <a class="house-room-back" href={homeHref}>Back to house</a>
      <div class="house-room-stage">
        <ConcertHallRoom />
      </div>
    </main>
  </body>
</html>
