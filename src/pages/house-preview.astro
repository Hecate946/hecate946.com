---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HouseExterior from '@/components/house/HouseExterior.astro';
import '@/styles/house-preview.css';

const seasons = [
  { id: 'spring', label: 'Spring' },
  { id: 'summer', label: 'Summer' },
  { id: 'autumn', label: 'Autumn' },
  { id: 'winter', label: 'Winter' },
] as const;
---

<BaseLayout
  title="House Preview"
  description="Preview the seasonal exterior of the house."
>
  <HouseExterior
    class="house-preview-page"
    ariaLabel="Preview of the seasonal house exterior"
    defaultOnly
  >
    <div
      class="house-preview-selector"
      role="group"
      aria-label="Preview season"
      data-house-preview-selector
    >
      {
        seasons.map((season) => (
          <button
            type="button"
            class="house-preview-season"
            data-preview-season-button={season.id}
            aria-pressed={season.id === 'winter' ? 'true' : 'false'}
          >
            {season.label}
          </button>
        ))
      }
    </div>
  </HouseExterior>

  <section data-html-only hidden>
    <h1>House Preview</h1>
    <p>Seasonal exterior preview. Available seasons:</p>
    <ul>
      {seasons.map((season) => <li>{season.label}</li>)}
    </ul>
  </section>
</BaseLayout>

<script>
  const VALID_SEASONS = ['spring', 'summer', 'autumn', 'winter'];

  function connectHousePreview() {
    const root = document.querySelector('[data-house-exterior]');
    const selector = document.querySelector('[data-house-preview-selector]');

    if (!(root instanceof HTMLElement) || !(selector instanceof HTMLElement)) {
      return;
    }

    // Keep this page independent from the site's saved season preference.
    // Winter is the current visual reference / anchor composition.
    let currentSeason = root.dataset.previewSeason;
    if (!currentSeason || !VALID_SEASONS.includes(currentSeason)) {
      currentSeason = 'winter';
      root.dataset.previewSeason = currentSeason;
    }

    const buttons = Array.from(
      selector.querySelectorAll('[data-preview-season-button]'),
    ).filter((button) => button instanceof HTMLButtonElement);

    const sync = () => {
      const season = root.dataset.previewSeason;
      for (const button of buttons) {
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.previewSeasonButton === season),
        );
      }
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const season = button.dataset.previewSeasonButton;
        if (!season || !VALID_SEASONS.includes(season)) return;

        root.dataset.previewSeason = season;
        sync();
      });
    }

    sync();
  }

  connectHousePreview();
  document.addEventListener('astro:page-load', connectHousePreview);
</script>
