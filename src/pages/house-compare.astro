---
import HouseIllustration from '@/components/house/HouseIllustration.svelte';
import { houseScene } from '@/config/house-scene';
import HousePreviewLayout from '@/layouts/HousePreviewLayout.astro';
import { withBase } from '@/lib/paths';
import '@/styles/house-scene.css';

const pngSrc = withBase('/images/house/house-white-current.png');
const destinations = houseScene.destinations.map((destination) => ({
  ...destination,
  href: withBase(destination.href),
}));
---

<HousePreviewLayout
  active="compare"
  title="House PNG / SVG Comparison — Cyrus Asasi"
  description="Side-by-side comparison of the frozen house PNG and the live HouseIllustration.svelte SVG presentation."
>
  <section class="house-comparison" aria-label="PNG and SVG house comparison">
    <figure class="house-comparison__panel">
      <figcaption>PNG reference</figcaption>
      <img
        src={pngSrc}
        alt="Blender PNG master of the white neoclassical house."
        draggable="false"
      />
    </figure>

    <figure class="house-comparison__panel">
      <figcaption>Interactive window overlay</figcaption>
      <div class="house-preview-art house-preview-art--svg house-comparison__svg-panel">
        <HouseIllustration {destinations} navigationEnabled={false} />
      </div>
    </figure>
  </section>
</HousePreviewLayout>
