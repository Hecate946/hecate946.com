---
import HouseIllustration from '@/components/house/HouseIllustration.svelte';
import { houseScene } from '@/config/house-scene';
import HousePreviewLayout from '@/layouts/HousePreviewLayout.astro';
import { withBase } from '@/lib/paths';
import '@/styles/house-scene.css';

const destinations = houseScene.destinations.map((destination) => ({
  ...destination,
  href: withBase(destination.href),
}));
---

<HousePreviewLayout
  active="svg"
  title="House SVG Preview — Cyrus Asasi"
  description="Full-screen preview of the live house SVG, window scenes, and aligned interaction regions."
>
  <div class="house-preview-art house-preview-art--svg">
    <HouseIllustration
      {destinations}
      navigationEnabled={false}
      debugWindows={false}
      scenesEnabled={true}
    />
  </div>
</HousePreviewLayout>


<script is:inline>
  function applyHousePreviewOptions() {
    const illustration = document.querySelector('.house-preview-art--svg .house-illustration');
    if (!(illustration instanceof SVGElement)) return;

    const params = new URLSearchParams(window.location.search);
    illustration.dataset.scenes = params.get('scenes') === 'off' ? 'off' : 'on';
    illustration.dataset.windowDebug = params.get('debug') === 'windows' ? 'true' : 'false';
  }

  applyHousePreviewOptions();
  document.addEventListener('astro:page-load', applyHousePreviewOptions);
</script>
