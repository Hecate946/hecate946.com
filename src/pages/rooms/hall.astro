---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HallRoom from '@/components/rooms/HallRoom.svelte';
---

<BaseLayout
  title="The Marble Hall | Cyrus Asasi"
  description="An immersive Cycles-rendered neoclassical marble hall with a fixed 360-degree viewpoint."
>
  <section class="hall-page">
    <HallRoom client:only="svelte" />
  </section>
</BaseLayout>

<style>
  .hall-page {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  :global(#main-content) {
    padding-inline: 0;
  }
</style>
