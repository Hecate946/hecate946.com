---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { secondStoryRooms } from '@/features/immersive/catalog';
import { withBase } from '@/lib/paths';
---

<BaseLayout
  title="Second-Story Rooms | Cyrus Asasi"
  description="Five immersive Cycles-rendered rooms in second-story window order."
>
  <section class="space-index">
    <header>
      <p>Second story</p>
      <h1>Five rooms</h1>
    </header>

    <nav aria-label="Second-story rooms">
      <ul class="space-grid" role="list">
        {
          secondStoryRooms.map((room) => (
            <li class="space-card" style={`--space-color: ${room.accent}`}>
              <a class="space-card__link" href={withBase(`/rooms/${room.slug}/`)}>
                <span>{room.label}</span>
                <strong>{room.title}</strong>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>
</BaseLayout>

<style>
  .space-index {
    width: min(72rem, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: clamp(3rem, 8vw, 8rem);
  }

  header p,
  header h1 {
    margin: 0;
  }

  header p {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  header h1 {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 7rem);
    font-weight: 400;
    line-height: 0.95;
  }

  .space-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
    padding: 0;
    margin: clamp(2rem, 5vw, 4rem) 0 0;
    list-style: none;
  }

  /* The list item owns the card boundary. This prevents a link or one of its
     descendants from ever painting or receiving pointer events outside the
     card it belongs to. */
  .space-card {
    position: relative;
    min-width: 0;
    min-height: 14rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--space-color), black 18%);
    border: 1px solid color-mix(in srgb, var(--space-color), white 26%);
    contain: paint;
    isolation: isolate;
  }

  .space-card__link {
    position: relative;
    inset: auto;
    z-index: 0;
    display: flex;
    width: 100%;
    height: 100%;
    min-height: inherit;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
    color: #fff;
    text-decoration: none;
    transition: filter 180ms ease, transform 180ms ease;
  }

  .space-card__link:hover,
  .space-card__link:focus-visible {
    color: #fff;
    filter: brightness(1.18);
    transform: translateY(-0.25rem);
  }

  .space-card__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -0.3rem;
  }

  span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  strong {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 2.2rem);
    font-weight: 400;
    line-height: 1;
  }

  @media (max-width: 760px) {
    .space-grid {
      grid-template-columns: 1fr;
    }

    .space-card {
      min-height: 8rem;
    }
  }
</style>
