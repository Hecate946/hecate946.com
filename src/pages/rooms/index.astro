---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { secondStoryRooms } from '@/features/immersive/catalog';
import { withBase } from '@/lib/paths';
---

<BaseLayout
  title="Second-Story Rooms | Cyrus Asasi"
  description="Five immersive Cycles-rendered rooms in second-story window order."
>
  <section class="space-index">
    <header>
      <p>Second story</p>
      <h1>Five rooms</h1>
    </header>

    <nav aria-label="Second-story rooms">
      {secondStoryRooms.map((room) => (
        <a href={withBase(`/rooms/${room.slug}/`)} style={`--space-color: ${room.accent}`}>
          <span>{room.label}</span>
          <strong>{room.title}</strong>
        </a>
      ))}
    </nav>
  </section>
</BaseLayout>

<style>
  .space-index {
    width: min(72rem, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: clamp(3rem, 8vw, 8rem);
  }

  header p,
  header h1 { margin: 0; }

  header p {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  header h1 {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 7rem);
    font-weight: 400;
    line-height: 0.95;
  }

  nav {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  a {
    display: flex;
    min-height: 14rem;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
    background: color-mix(in srgb, var(--space-color), black 18%);
    border: 1px solid color-mix(in srgb, var(--space-color), white 26%);
    color: #fff;
    text-decoration: none;
    transition: transform 180ms ease, filter 180ms ease;
  }

  a:hover {
    filter: brightness(1.18);
    transform: translateY(-0.25rem);
  }

  span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  strong {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 2.2rem);
    font-weight: 400;
    line-height: 1;
  }

  @media (max-width: 760px) {
    nav { grid-template-columns: 1fr; }
    a { min-height: 8rem; }
  }
</style>
