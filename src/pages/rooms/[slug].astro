---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PanoramaViewer from '@/features/immersive/PanoramaViewer.svelte';
import { secondStoryRooms, type ImmersiveSpace } from '@/features/immersive/catalog';

export function getStaticPaths() {
  return secondStoryRooms.map((space) => ({
    params: { slug: space.slug },
    props: { space },
  }));
}

interface Props {
  space: ImmersiveSpace;
}

const { space } = Astro.props;
---

<BaseLayout title={`${space.title} | Cyrus Asasi`} description={space.description}>
  <section class="panorama-page">
    <PanoramaViewer client:only="svelte" {space} />
  </section>
</BaseLayout>

<style>
  .panorama-page {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  :global(#main-content) {
    padding-inline: 0;
  }
</style>
