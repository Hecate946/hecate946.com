---
import { withBase } from '@/lib/paths';

const destination = withBase('/about/');
const canonical = new URL(destination, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <meta
      name="description"
      content="This archived About URL redirects to the current About page."
    />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={canonical} />
    <title>About — Cyrus Asasi</title>
  </head>
  <body>
    <p>This page moved to <a href={destination}>About</a>.</p>
  </body>
</html>
