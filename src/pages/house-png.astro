---
import HousePreviewLayout from '@/layouts/HousePreviewLayout.astro';
import { withBase } from '@/lib/paths';

const imageSrc = withBase('/images/house/house-white-current.png');
---

<HousePreviewLayout
  active="png"
  title="House PNG Preview — Cyrus Asasi"
  description="Full-screen preview of the current transparent Blender house PNG."
>
  <figure class="house-preview-art house-preview-art--png">
    <img
      src={imageSrc}
      alt="Cream neoclassical house with a dark blue-green slate roof, five upper windows, two broad lower windows, and a centered arched entrance."
      draggable="false"
    />
  </figure>
</HousePreviewLayout>
