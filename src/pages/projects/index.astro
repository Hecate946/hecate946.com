---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectGallery from '@/components/projects/ProjectGallery.astro';
import { indexProjects } from '@/data/projects';

const projectsUrl = new URL('/projects/', Astro.site).href;
const itemListStructuredData = {
  '@type': 'ItemList',
  '@id': `${projectsUrl}#selected-projects`,
  name: 'Selected software projects by Cyrus Asasi',
  numberOfItems: indexProjects.length,
  itemListElement: indexProjects.map((project, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(project.primaryHref, Astro.site).href,
    name: project.title,
  })),
};
---

<BaseLayout
  title="Projects"
  description="Selected software projects by Cyrus Asasi, including 3tap, KeyCAD, Sunset, Neutra, and Hecate946.com."
  socialTitle="Projects"
  socialDescription="3tap, KeyCAD, Sunset, Neutra, Hecate946.com, and smaller experiments."
  socialImage="/images/social/projects.jpg"
  socialImageAlt="Selected software projects by Cyrus Asasi"
  socialImageWidth={400}
  socialImageHeight={400}
  mainEntityId={`${projectsUrl}#selected-projects`}
  structuredData={itemListStructuredData}
  mainClass="projects-wall-main"
  bodyClass="projects-wall-page"
>
  <ProjectGallery />
</BaseLayout>
