---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ForceNetwork from '@/components/graphs/ForceNetwork.svelte';
import {
  navigationNetworkLinks,
  navigationNetworkNodes,
} from '@/data/navigation-network';
import '@/styles/navigation.css';
---

<BaseLayout
  title="Navigation — Cyrus Asasi"
  description="An interactive map of the primary pages on hecate946.com."
  noindex
>
  <section class="navigation-graph" aria-labelledby="navigation-title">
    <h1 id="navigation-title" class="visually-hidden">Site navigation</h1>

    <div class="navigation-graph__stage">
      <ForceNetwork
        client:visible
        nodes={navigationNetworkNodes}
        links={navigationNetworkLinks}
        centerNodeId="home"
        idPrefix="navigation-network"
        ariaLabel="Portfolio navigation centered on Cyrus Asasi"
        height="min(76svh, 49rem)"
        collisionSounds={true}
        settings={{
          layout: 'radial',
          radialRadius: 0.325,
          radialStartAngle: -Math.PI / 2,
          entranceRadius: 0,
          chargeStrength: -190,
          anchorStrength: 0.18,
          centerAnchorStrength: 0.42,
          collisionPadding: 18,
          linkStrength: 0.2,
        }}
      />
    </div>

  </section>
</BaseLayout>
