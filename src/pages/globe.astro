---
import VisitorGlobeClearV2 from '@/components/islands/VisitorGlobeClearV2.svelte';
import { STATS_API_BASE } from '@/lib/stats-api';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/paths';

const statsApiBase = STATS_API_BASE;
---

<BaseLayout
  title="Visitor Globe — Cyrus Asasi"
  description="A draggable three-dimensional prototype of the visitor map on hecate946.com."
  hideFooter={true}
  suppressSeasonalShower={true}
  mainClass="visitor-globe-main"
  bodyClass="visitor-globe-body"
  soundSilent={true}
  noindex={true}
>
  <div class="visitor-globe-page" data-default-only>
    <a class="visitor-globe-close" href={withBase('/stats/')} aria-label="Back to stats">×</a>
    <VisitorGlobeClearV2 client:load apiBase={statsApiBase} />
  </div>

  <section class="visitor-globe-html" data-html-only hidden>
    <h1>Visitor Globe</h1>
    <p>The interactive 3D globe is available in the default visual mode.</p>
    <p><a href={withBase('/stats/')}>Back to Stats</a></p>
  </section>
</BaseLayout>

<style is:global>
  html,
  body.visitor-globe-body {
    width: 100%;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
    background: var(--bg);
  }

  body.visitor-globe-body .site-header {
    display: none !important;
  }

  #main-content.visitor-globe-main {
    box-sizing: border-box;
    width: 100%;
    height: 100dvh;
    min-height: 0;
    margin: 0;
    padding: 0 !important;
    overflow: hidden;
  }

  .visitor-globe-page,
  .visitor-globe-page > astro-island {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: var(--bg);
  }

  .visitor-globe-page {
    position: relative;
  }

  .visitor-globe-close {
    position: absolute;
    z-index: 5;
    top: clamp(1rem, 2.4vw, 1.5rem);
    left: clamp(1rem, 2.4vw, 1.5rem);
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    color: var(--text);
    font-family: Arial, sans-serif;
    font-size: 1.35rem;
    line-height: 1;
    text-decoration: none;
    backdrop-filter: blur(8px);
  }

  .visitor-globe-close:hover {
    border-color: var(--text);
  }

  .visitor-globe-page .globe-meta {
    left: clamp(4.15rem, 7vw, 4.65rem);
  }

  .visitor-globe-html {
    padding: 2rem var(--site-edge);
  }

</style>
