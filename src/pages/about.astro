---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AboutBook from '@/components/about/AboutBook.svelte';
import WallBackdrop from '@/features/wall/WallBackdrop.svelte';
import FloorScene from '@/features/floor/FloorScene.svelte';
import { withBase } from '@/lib/paths';
import '@/styles/about.css';

const portraitUrl = withBase('/images/about/cyrus-portrait.webp');
---

<BaseLayout
  title="About — Cyrus Asasi"
  description="Software engineer, classical musician, competitive pickleball player, and chess enthusiast."
  bodyClass="about-room-page"
>
  <div class="about-room wall-room-host">
    <WallBackdrop />
    <FloorScene client:load />
    <AboutBook client:load {portraitUrl} />
  </div>
</BaseLayout>
