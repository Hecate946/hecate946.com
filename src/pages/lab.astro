---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteRoutes } from '@/lib/site-routes';
import { withBase } from '@/lib/paths';
import '@/styles/lab.css';

const primaryRoutes = new Set([
  '/',
  '/about/',
  '/projects/',
  '/contact/',
  '/stats/',
  '/lab/',
]);

const labRoutes = siteRoutes.filter(
  (route) =>
    !primaryRoutes.has(route.href) &&
    !route.href.startsWith('/projects/'),
);

const sections = [
  {
    id: 'experiments',
    label: 'Experiments',
    routes: labRoutes.filter((route) => route.category === 'experiments'),
  },
  {
    id: 'spaces',
    label: 'Spaces',
    routes: labRoutes.filter((route) => route.category === 'spaces'),
  },
  {
    id: 'systems',
    label: 'Systems',
    routes: labRoutes.filter((route) => route.category === 'core'),
  },
].filter((section) => section.routes.length > 0);

let routeNumber = 0;
---

<BaseLayout
  title="Lab"
  description="Experiments, prototypes, immersive spaces, and side paths from hecate946.com."
>
  <section class="lab-page interior-page interior-page--eight" aria-labelledby="lab-title">
    <header class="lab-heading interior-page-heading">
      <div>
        <p class="lab-kicker">Index / {String(labRoutes.length).padStart(2, '0')}</p>
        <h1 id="lab-title">Lab</h1>
      </div>
    </header>

    <div class="lab-content interior-page-content interior-page-content--balanced">
      <section class="lab-index-block" aria-labelledby="lab-index-heading">
        <header class="lab-section-heading lab-index-heading">
          <h2 id="lab-index-heading">Index</h2>
          <span>{String(labRoutes.length).padStart(2, '0')}</span>
        </header>

        <p class="lab-intro">
          Experiments, prototypes, rooms, and other things that are allowed to stay a little strange.
        </p>

        <div class="lab-index">
          {
            sections.map((section) => (
              <section class="lab-section" aria-labelledby={`lab-${section.id}`}>
                <header class="lab-section-heading">
                  <h3 id={`lab-${section.id}`}>{section.label}</h3>
                  <span>{String(section.routes.length).padStart(2, '0')}</span>
                </header>

                <ol class="lab-list">
                  {section.routes.map((route) => {
                    routeNumber += 1;
                    const index = String(routeNumber).padStart(2, '0');
                    return (
                      <li>
                        <a href={withBase(route.href)} data-astro-prefetch>
                          <span class="lab-number" aria-hidden="true">{index}</span>
                          <span class="lab-name">{route.label}</span>
                          <span class="lab-description">{route.description ?? route.href}</span>
                          <span class="lab-arrow" aria-hidden="true">↗</span>
                        </a>
                      </li>
                    );
                  })}
                </ol>
              </section>
            ))
          }
        </div>
      </section>

    </div>
  </section>
</BaseLayout>
