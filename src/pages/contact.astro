---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactChalkboard from '@/components/contact/ContactChalkboard.astro';
import '@/styles/contact.css';
---

<BaseLayout
  title="Contact — Cyrus Asasi"
  description="Contact Cyrus Asasi through email, GitHub, LinkedIn, Chess.com, Spotify, and other profile links."
>
  <div class="contact-page interior-page interior-page--open">
    <header class="interior-page-heading">
      <h1 id="contact-title">Contact</h1>
    </header>

    <section class="contact-wall" aria-labelledby="contact-title">
      <ContactChalkboard />
    </section>
  </div>
</BaseLayout>
