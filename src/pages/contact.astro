---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactChalkboard from '@/components/contact/ContactChalkboard.astro';
---

<BaseLayout
  title="Contact"
  description="Contact Cyrus Asasi by email or through GitHub, LinkedIn, and Buy Me a Coffee."
  socialTitle="Contact Cyrus"
  socialDescription="Email, GitHub, LinkedIn, and Buy Me a Coffee."
  socialImage="/images/social/contact.jpg"
  socialImageAlt="Contact room with an email composer and links to GitHub, LinkedIn, and Buy Me a Coffee"
  socialImageWidth={400}
  socialImageHeight={400}
  mainClass="contact-room-main"
  bodyClass="contact-room-page"
>
  <div class="page-scroll-installation contact-page">
    <div class="page-scroll-hanging">
      <article class="page-scroll-paper" aria-labelledby="contact-scroll-title">
        <div
          class="page-scroll-paper__roll page-scroll-paper__roll--top"
          aria-hidden="true"
        >
        </div>

        <div class="page-scroll-paper__sheet">
          <div
            class="page-scroll-paper__viewport contact-scroll-viewport"
            tabindex="0"
            aria-label="Contact content"
          >
            <header class="page-scroll-header">
              <h1 id="contact-scroll-title">Contact</h1>
              <div class="page-scroll-header__rule" aria-hidden="true"></div>
            </header>

            <section class="contact-wall" aria-label="Contact options">
              <ContactChalkboard />
            </section>
          </div>
        </div>

        <div
          class="page-scroll-paper__roll page-scroll-paper__roll--bottom"
          aria-hidden="true"
        >
        </div>
      </article>
    </div>
  </div>
</BaseLayout>
