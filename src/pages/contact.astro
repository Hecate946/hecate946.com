---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactChalkboard from '@/components/contact/ContactChalkboard.astro';
---

<BaseLayout
  title="Contact — Cyrus Asasi"
  description="Contact Cyrus Asasi by email or through GitHub, LinkedIn, and Buy Me a Coffee."
  socialTitle="Contact Cyrus"
  socialDescription="Email, GitHub, LinkedIn, and Buy Me a Coffee."
  socialImage="/images/social/contact.jpg"
  socialImageAlt="Contact room preview with GitHub, LinkedIn, email, and Buy Me a Coffee icons on a chalkboard"
  socialImageWidth={400}
  socialImageHeight={400}
  socialImageType="image/jpeg"
  mainClass="contact-room-main"
  bodyClass="contact-room-page"
>
  <div class="contact-page interior-page interior-page--open">
    <h1 class="visually-hidden">Contact Cyrus Asasi</h1>
    <section class="contact-wall" aria-label="Contact chalkboard">
      <ContactChalkboard />
    </section>
  </div>
</BaseLayout>
