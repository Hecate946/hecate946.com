---
import StatsObservatory from '@/components/islands/StatsObservatory.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { STATS_API_BASE } from '@/lib/stats-api';
import { withBase } from '@/lib/paths';
import '@/styles/stats.css';
import '@/styles/stats-observatory.css';

const statsApiBase = STATS_API_BASE;
const statsApiOrigin = statsApiBase.startsWith('http') ? new URL(statsApiBase).origin : '';
---

<BaseLayout
  title="Stats — Cyrus Asasi"
  description="The website, observed: a live interactive view of anonymous visitor activity, traffic, time, and browsing paths on hecate946.com."
  socialTitle="Site Stats"
  socialDescription="A live, privacy-conscious view of activity on hecate946.com."
  socialImage="/images/social/stats.jpg"
  socialImageAlt="Stats room preview with a dark globe and visitor lights"
  socialImageWidth={400}
  socialImageHeight={400}
  socialImageType="image/jpeg"
>
  <Fragment slot="head">
    {statsApiOrigin && <link rel="preconnect" href={statsApiOrigin} crossorigin />}
  </Fragment>
  <section class="stats-observatory-page interior-page interior-page--eight" aria-labelledby="stats-title">
    <header class="interior-page-heading">
      <h1 id="stats-title">Stats</h1>
    </header>

    <div class="stats-observatory-content interior-page-content">
      <div>
        <StatsObservatory client:visible apiBase={statsApiBase} />
        <p class="stats-privacy-note">
          <a href={withBase('/privacy/')}>Privacy</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
